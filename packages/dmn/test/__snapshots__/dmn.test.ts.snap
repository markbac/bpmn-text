          },
          {
            "id": "OutputClause_approve_loan_2",
            "name": "Reason",
            "typeRef": "string",
          },
        ],
        "rules": [
          {
            "description": "Standard approval",
            "id": "Rule_approve_loan_1",
            "index": 1,
            "inputEntries": [
              {
                "id": "UnaryTests_approve_loan_1_1",
                "text": ">= 700",
              },
              {
                "id": "UnaryTests_approve_loan_1_2",
                "text": "<= 50000",
              },
            ],
            "outputEntries": [
              {
                "id": "LiteralExpression_approve_loan_1_1",
                "text": "true",
              },
              {
                "id": "LiteralExpression_approve_loan_1_2",
                "text": ""Good score"",
              },
            ],
          },
          {
            "description": "Refer to a specialist",
            "id": "Rule_approve_loan_2",
            "index": 2,
            "inputEntries": [
              {
                "id": "UnaryTests_approve_loan_2_1",
                "text": ">= 700",
              },
              {
                "id": "UnaryTests_approve_loan_2_2",
                "text": "> 50000",
              },
            ],
            "outputEntries": [
              {
                "id": "LiteralExpression_approve_loan_2_1",
                "text": "false",
              },
              {
                "id": "LiteralExpression_approve_loan_2_2",
                "text": ""Amount too high"",
              },
            ],
          },
          {
            "id": "Rule_approve_loan_3",
            "index": 3,
            "inputEntries": [
              {
                "id": "UnaryTests_approve_loan_3_1",
                "text": "< 700",
              },
              {
                "id": "UnaryTests_approve_loan_3_2",
                "text": "-",
              },
            ],
            "outputEntries": [
              {
                "id": "LiteralExpression_approve_loan_3_1",
                "text": "false",
              },
              {
                "id": "LiteralExpression_approve_loan_3_2",
                "text": ""Low score"",
              },
            ],
          },
        ],
        "type": "table",
      },
      "name": "Approve loan",
    },
  ],
  "id": "Definitions_loan_approval",
  "name": "Loan approval",
  "requirements": [
    {
      "from": "InputData_credit_score",
      "id": "InformationRequirement_credit_score__approve_loan",
      "kind": "information",
      "to": "Decision_approve_loan",
    },
    {
      "from": "InputData_loan_amount",
      "id": "InformationRequirement_loan_amount__approve_loan",
      "kind": "information",
