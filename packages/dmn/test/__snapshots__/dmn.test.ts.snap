        "id": "DecisionTable_approve_loan",
        "inputs": [
          {
            "expression": "Credit score",
            "expressionId": "InputExpression_approve_loan_1",
            "id": "InputClause_approve_loan_1",
            "typeRef": "number",
          },
          {
            "expression": "Loan amount",
