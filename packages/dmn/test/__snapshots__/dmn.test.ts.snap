exports[`DMN model builder and validator (#72) > examples/dmn/04-literal-expressions.dmnt matches its model snapshot 1`] = `
{
  "elements": [
    {
      "id": "InputData_order_total",
      "kind": "input",
      "name": "Order total",
      "typeRef": "number",
    },
    {
      "id": "InputData_order_date",
      "kind": "input",
      "name": "Order date",
      "typeRef": "date",
    },
    {
      "id": "InputData_destination",
      "kind": "input",
      "name": "Destination",
      "typeRef": "string",
      "values": ""home","abroad"",
    },
    {
      "doc": "The carrier rate per kilogram, by zone.",
      "id": "BusinessKnowledgeModel_rate",
      "kind": "knowledge",
      "logic": {
        "id": "LiteralExpression_rate",
        "text": "if Zone = "abroad" then Weight * 4 else Weight * 1.5",
        "type": "literal",
      },
      "name": "Rate",
      "params": [
        {
          "name": "Weight",
        },
        {
          "name": "Zone",
        },
      ],
      "typeRef": "number",
    },
    {
      "id": "Decision_free_shipping",
      "kind": "decision",
      "logic": {
        "id": "LiteralExpression_free_shipping",
        "text": "Order total >= 100
or Order date < date("2027-01-01")",
        "type": "literal",
      },
      "name": "Free shipping",
      "typeRef": "boolean",
    },
    {
      "id": "Decision_shipping_cost",
      "kind": "decision",
      "logic": {
        "id": "LiteralExpression_shipping_cost",
        "text": "if Free shipping then 0 else Rate(2, Destination)",
        "type": "literal",
      },
      "name": "Shipping cost",
      "typeRef": "number",
    },
  ],
  "id": "Definitions_shipping",
  "name": "Shipping",
  "requirements": [
    {
      "from": "InputData_order_total",
      "id": "InformationRequirement_order_total__free_shipping",
      "kind": "information",
      "to": "Decision_free_shipping",
    },
    {
      "from": "InputData_order_date",
      "id": "InformationRequirement_order_date__free_shipping",
      "kind": "information",
      "to": "Decision_free_shipping",
    },
    {
      "from": "Decision_free_shipping",
      "id": "InformationRequirement_free_shipping__shipping_cost",
      "kind": "information",
      "to": "Decision_shipping_cost",
    },
    {
      "from": "InputData_destination",
      "id": "InformationRequirement_destination__shipping_cost",
      "kind": "information",
      "to": "Decision_shipping_cost",
    },
    {
      "from": "BusinessKnowledgeModel_rate",
      "id": "KnowledgeRequirement_rate__shipping_cost",
      "kind": "knowledge",
      "to": "Decision_shipping_cost",
    },
  ],
}
`;

