<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Invoice run" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:dataStore id="DataStore_accounting_db" name="Accounting DB" />
  <bpmn:process id="Process_invoice_run" name="Invoice run" isExecutable="false">
    <bpmn:startEvent id="Event_last_working_day_of_month" name="Last working day of month">
      <bpmn:outgoing>Flow_last_working_day_of_month__collect_billable_hours</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_last_working_day_of_month_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_collect_billable_hours" name="Collect billable hours">
      <bpmn:incoming>Flow_last_working_day_of_month__collect_billable_hours</bpmn:incoming>
      <bpmn:outgoing>Flow_collect_billable_hours__create_invoices</bpmn:outgoing>
      <bpmn:property id="Activity_collect_billable_hours_property" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_collect_billable_hours__accounting_db">
        <bpmn:sourceRef>DataStoreReference_accounting_db</bpmn:sourceRef>
        <bpmn:targetRef>Activity_collect_billable_hours_property</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_collect_billable_hours__hours_report">
        <bpmn:targetRef>DataObjectReference_hours_report</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Activity_create_invoices" name="Create invoices">
      <bpmn:incoming>Flow_collect_billable_hours__create_invoices</bpmn:incoming>
      <bpmn:outgoing>Flow_create_invoices__send_invoices</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics />
      <bpmn:startEvent id="Event_create_invoices_start_1">
        <bpmn:outgoing>Flow_create_invoices_start_1__calculate_totals</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_calculate_totals" name="Calculate totals">
        <bpmn:incoming>Flow_create_invoices_start_1__calculate_totals</bpmn:incoming>
        <bpmn:outgoing>Flow_calculate_totals__generate_pdf</bpmn:outgoing>
        <bpmn:property id="Activity_calculate_totals_property" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_calculate_totals__hours_report">
          <bpmn:sourceRef>DataObjectReference_hours_report</bpmn:sourceRef>
          <bpmn:targetRef>Activity_calculate_totals_property</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:task>
      <bpmn:serviceTask id="Activity_generate_pdf" name="Generate PDF">
        <bpmn:incoming>Flow_calculate_totals__generate_pdf</bpmn:incoming>
        <bpmn:outgoing>Flow_generate_pdf__create_invoices_end_1</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_generate_pdf__invoice">
          <bpmn:targetRef>DataObjectReference_invoice</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_create_invoices_end_1">
        <bpmn:incoming>Flow_generate_pdf__create_invoices_end_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_create_invoices_start_1__calculate_totals" sourceRef="Event_create_invoices_start_1" targetRef="Activity_calculate_totals" />
      <bpmn:sequenceFlow id="Flow_calculate_totals__generate_pdf" sourceRef="Activity_calculate_totals" targetRef="Activity_generate_pdf" />
      <bpmn:sequenceFlow id="Flow_generate_pdf__create_invoices_end_1" sourceRef="Activity_generate_pdf" targetRef="Event_create_invoices_end_1" />
      <bpmn:dataObjectReference id="DataObjectReference_invoice" name="Invoice" dataObjectRef="DataObject_invoice" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_missing_rate" name="Missing rate" attachedToRef="Activity_create_invoices">
      <bpmn:outgoing>Flow_missing_rate__fix_rate_card</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Event_missing_rate_definition" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Activity_fix_rate_card" name="Fix rate card">
      <bpmn:incoming>Flow_missing_rate__fix_rate_card</bpmn:incoming>
      <bpmn:outgoing>Flow_fix_rate_card__invoice_skipped</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_invoice_skipped" name="Invoice skipped">
      <bpmn:incoming>Flow_fix_rate_card__invoice_skipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_send_invoices" name="Send invoices">
      <bpmn:incoming>Flow_create_invoices__send_invoices</bpmn:incoming>
      <bpmn:outgoing>Flow_send_invoices__run_complete</bpmn:outgoing>
      <bpmn:startEvent id="Event_send_invoices_start_1">
        <bpmn:outgoing>Flow_send_invoices_start_1__email_invoice</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_email_invoice" name="Email invoice">
        <bpmn:incoming>Flow_send_invoices_start_1__email_invoice</bpmn:incoming>
        <bpmn:outgoing>Flow_email_invoice__30_days</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="Event_30_days" name="30 days">
        <bpmn:incoming>Flow_email_invoice__30_days</bpmn:incoming>
        <bpmn:outgoing>Flow_30_days__check_payment</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Event_30_days_definition" />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="Activity_check_payment" name="Check payment">
        <bpmn:incoming>Flow_30_days__check_payment</bpmn:incoming>
        <bpmn:outgoing>Flow_check_payment__send_invoices_end_1</bpmn:outgoing>
        <bpmn:standardLoopCharacteristics />
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_send_invoices_end_1">
        <bpmn:incoming>Flow_check_payment__send_invoices_end_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_send_invoices_start_1__email_invoice" sourceRef="Event_send_invoices_start_1" targetRef="Activity_email_invoice" />
      <bpmn:sequenceFlow id="Flow_email_invoice__30_days" sourceRef="Activity_email_invoice" targetRef="Event_30_days" />
      <bpmn:sequenceFlow id="Flow_30_days__check_payment" sourceRef="Event_30_days" targetRef="Activity_check_payment" />
      <bpmn:sequenceFlow id="Flow_check_payment__send_invoices_end_1" sourceRef="Activity_check_payment" targetRef="Event_send_invoices_end_1" />
    </bpmn:subProcess>
    <bpmn:endEvent id="Event_run_complete" name="Run complete">
      <bpmn:incoming>Flow_send_invoices__run_complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_last_working_day_of_month__collect_billable_hours" sourceRef="Event_last_working_day_of_month" targetRef="Activity_collect_billable_hours" />
    <bpmn:sequenceFlow id="Flow_collect_billable_hours__create_invoices" sourceRef="Activity_collect_billable_hours" targetRef="Activity_create_invoices" />
    <bpmn:sequenceFlow id="Flow_missing_rate__fix_rate_card" sourceRef="Event_missing_rate" targetRef="Activity_fix_rate_card" />
    <bpmn:sequenceFlow id="Flow_fix_rate_card__invoice_skipped" sourceRef="Activity_fix_rate_card" targetRef="Event_invoice_skipped" />
    <bpmn:sequenceFlow id="Flow_create_invoices__send_invoices" sourceRef="Activity_create_invoices" targetRef="Activity_send_invoices" />
    <bpmn:sequenceFlow id="Flow_send_invoices__run_complete" sourceRef="Activity_send_invoices" targetRef="Event_run_complete" />
    <bpmn:dataObject id="DataObject_hours_report" />
    <bpmn:dataObject id="DataObject_invoice" />
    <bpmn:dataObjectReference id="DataObjectReference_hours_report" name="Hours report" dataObjectRef="DataObject_hours_report" />
    <bpmn:dataStoreReference id="DataStoreReference_accounting_db" name="Accounting DB" dataStoreRef="DataStore_accounting_db" />
    <bpmn:textAnnotation id="TextAnnotation_collect_billable_hours">
      <bpmn:text>Includes contractors from the timesheet export</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_collect_billable_hours" sourceRef="Activity_collect_billable_hours" targetRef="TextAnnotation_collect_billable_hours" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_invoice_run">
