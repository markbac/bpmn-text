      </dmn:input>
      <dmn:output id="OutputClause_rule_order_1" name="Message" typeRef="string" />
      <dmn:rule id="Rule_rule_order_1">
        <dmn:inputEntry id="UnaryTests_rule_order_1_1">
          <dmn:text>&gt;= 10</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_rule_order_1_1">
          <dmn:text>"Thanks for coming"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_rule_order_2">
        <dmn:inputEntry id="UnaryTests_rule_order_2_1">
          <dmn:text>-</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_rule_order_2_1">
          <dmn:text>"Welcome"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
  <dmn:decision id="Decision_output_order" name="Output order">
