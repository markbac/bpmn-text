    <dmn:decisionTable id="DecisionTable_rule_order" hitPolicy="RULE ORDER">
      <dmn:input id="InputClause_rule_order_1">
        <dmn:inputExpression id="InputExpression_rule_order_1" typeRef="number">
          <dmn:text>Points</dmn:text>
