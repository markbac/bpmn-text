        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_output_order_3_1">
          <dmn:text>"drink"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
