        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_output_order_1_1">
          <dmn:text>"lounge"</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="Rule_output_order_2">
        <dmn:inputEntry id="UnaryTests_output_order_2_1">
          <dmn:text>&gt;= 10</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry id="LiteralExpression_output_order_2_1">
          <dmn:text>"upgrade"</dmn:text>
        </dmn:outputEntry>
