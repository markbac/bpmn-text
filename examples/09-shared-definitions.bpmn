<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Refund request" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_customer" name="Customer" processRef="Process_customer" />
    <bpmn:participant id="Participant_shop" name="Shop" processRef="Process_shop" />
    <bpmn:messageFlow id="MessageFlow_ask_for_a_refund__request_received" sourceRef="Activity_ask_for_a_refund" targetRef="Event_request_received" messageRef="Message_refund_request" />
    <bpmn:messageFlow id="MessageFlow_reject_request__refund_decision" sourceRef="Activity_reject_request" targetRef="Event_refund_decision" messageRef="Message_refund_decision" />
    <bpmn:messageFlow id="MessageFlow_confirm_refund__refund_decision" sourceRef="Activity_confirm_refund" targetRef="Event_refund_decision" messageRef="Message_refund_decision" />
  </bpmn:collaboration>
  <bpmn:message id="Message_refund_request" name="Refund request" />
  <bpmn:message id="Message_refund_decision" name="Refund decision" />
  <bpmn:error id="Error_order_unknown" name="Order unknown" />
  <bpmn:signal id="Signal_refund_paid" name="Refund paid" />
  <bpmn:process id="Process_customer" isExecutable="false">
    <bpmn:startEvent id="Event_refund_wanted" name="Refund wanted">
      <bpmn:outgoing>Flow_refund_wanted__ask_for_a_refund</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_ask_for_a_refund" name="Ask for a refund" messageRef="Message_refund_request">
      <bpmn:incoming>Flow_refund_wanted__ask_for_a_refund</bpmn:incoming>
      <bpmn:outgoing>Flow_ask_for_a_refund__refund_decision</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_refund_decision" name="Refund decision">
      <bpmn:incoming>Flow_ask_for_a_refund__refund_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_refund_decision__answer_received</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_refund_decision_definition" messageRef="Message_refund_decision" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="Event_answer_received" name="Answer received">
      <bpmn:incoming>Flow_refund_decision__answer_received</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_refund_wanted__ask_for_a_refund" sourceRef="Event_refund_wanted" targetRef="Activity_ask_for_a_refund" />
    <bpmn:sequenceFlow id="Flow_ask_for_a_refund__refund_decision" sourceRef="Activity_ask_for_a_refund" targetRef="Event_refund_decision" />
    <bpmn:sequenceFlow id="Flow_refund_decision__answer_received" sourceRef="Event_refund_decision" targetRef="Event_answer_received" />
  </bpmn:process>
  <bpmn:process id="Process_shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_shop">
      <bpmn:lane id="Lane_service" name="Service">
        <bpmn:flowNodeRef>Event_request_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_check_the_purchase</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_order_unknown_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_reject_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_refund_paid_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_close_the_case</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_case_closed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_finance" name="Finance">
        <bpmn:flowNodeRef>Activity_pay_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_refund_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_confirm_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_refunded</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_request_received" name="Request received">
      <bpmn:outgoing>Flow_request_received__check_the_purchase</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_request_received_definition" messageRef="Message_refund_request" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_check_the_purchase" name="Check the purchase">
      <bpmn:incoming>Flow_request_received__check_the_purchase</bpmn:incoming>
      <bpmn:outgoing>Flow_check_the_purchase__pay_refund</bpmn:outgoing>
      <bpmn:startEvent id="Event_check_the_purchase_start_1">
        <bpmn:outgoing>Flow_check_the_purchase_start_1__find_order</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_find_order" name="Find order">
        <bpmn:incoming>Flow_check_the_purchase_start_1__find_order</bpmn:incoming>
        <bpmn:outgoing>Flow_find_order__order_found</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_order_found" name="Order found?">
        <bpmn:incoming>Flow_find_order__order_found</bpmn:incoming>
        <bpmn:outgoing>Flow_order_found__checked</bpmn:outgoing>
        <bpmn:outgoing>Flow_order_found__order_unknown</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_checked" name="Checked">
        <bpmn:incoming>Flow_order_found__checked</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Event_order_unknown" name="Order unknown">
        <bpmn:incoming>Flow_order_found__order_unknown</bpmn:incoming>
        <bpmn:errorEventDefinition id="Event_order_unknown_definition" errorRef="Error_order_unknown" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_check_the_purchase_start_1__find_order" sourceRef="Event_check_the_purchase_start_1" targetRef="Activity_find_order" />
      <bpmn:sequenceFlow id="Flow_find_order__order_found" sourceRef="Activity_find_order" targetRef="Gateway_order_found" />
      <bpmn:sequenceFlow id="Flow_order_found__checked" name="yes" sourceRef="Gateway_order_found" targetRef="Event_checked" />
      <bpmn:sequenceFlow id="Flow_order_found__order_unknown" name="no" sourceRef="Gateway_order_found" targetRef="Event_order_unknown" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Event_order_unknown_2" name="Order unknown" attachedToRef="Activity_check_the_purchase">
      <bpmn:outgoing>Flow_order_unknown_2__reject_request</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Event_order_unknown_2_definition" errorRef="Error_order_unknown" />
    </bpmn:boundaryEvent>
    <bpmn:sendTask id="Activity_reject_request" name="Reject request">
      <bpmn:incoming>Flow_order_unknown_2__reject_request</bpmn:incoming>
      <bpmn:outgoing>Flow_reject_request__rejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_rejected" name="Rejected">
      <bpmn:incoming>Flow_reject_request__rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_pay_refund" name="Pay refund">
      <bpmn:incoming>Flow_check_the_purchase__pay_refund</bpmn:incoming>
      <bpmn:outgoing>Flow_pay_refund__refund_paid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_refund_paid" name="Refund paid">
      <bpmn:incoming>Flow_pay_refund__refund_paid</bpmn:incoming>
      <bpmn:outgoing>Flow_refund_paid__confirm_refund</bpmn:outgoing>
      <bpmn:signalEventDefinition id="Event_refund_paid_definition" signalRef="Signal_refund_paid" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sendTask id="Activity_confirm_refund" name="Confirm refund">
      <bpmn:incoming>Flow_refund_paid__confirm_refund</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_refund__refunded</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_refunded" name="Refunded">
      <bpmn:incoming>Flow_confirm_refund__refunded</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_refund_paid_2" name="Refund paid">
      <bpmn:outgoing>Flow_refund_paid_2__close_the_case</bpmn:outgoing>
      <bpmn:signalEventDefinition id="Event_refund_paid_2_definition" signalRef="Signal_refund_paid" />
    </bpmn:startEvent>
    <bpmn:task id="Activity_close_the_case" name="Close the case">
      <bpmn:incoming>Flow_refund_paid_2__close_the_case</bpmn:incoming>
      <bpmn:outgoing>Flow_close_the_case__case_closed</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_case_closed" name="Case closed">
      <bpmn:incoming>Flow_close_the_case__case_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_request_received__check_the_purchase" sourceRef="Event_request_received" targetRef="Activity_check_the_purchase" />
    <bpmn:sequenceFlow id="Flow_order_unknown_2__reject_request" sourceRef="Event_order_unknown_2" targetRef="Activity_reject_request" />
    <bpmn:sequenceFlow id="Flow_reject_request__rejected" sourceRef="Activity_reject_request" targetRef="Event_rejected" />
    <bpmn:sequenceFlow id="Flow_check_the_purchase__pay_refund" sourceRef="Activity_check_the_purchase" targetRef="Activity_pay_refund" />
    <bpmn:sequenceFlow id="Flow_pay_refund__refund_paid" sourceRef="Activity_pay_refund" targetRef="Event_refund_paid" />
    <bpmn:sequenceFlow id="Flow_refund_paid__confirm_refund" sourceRef="Event_refund_paid" targetRef="Activity_confirm_refund" />
    <bpmn:sequenceFlow id="Flow_confirm_refund__refunded" sourceRef="Activity_confirm_refund" targetRef="Event_refunded" />
    <bpmn:sequenceFlow id="Flow_refund_paid_2__close_the_case" sourceRef="Event_refund_paid_2" targetRef="Activity_close_the_case" />
    <bpmn:sequenceFlow id="Flow_close_the_case__case_closed" sourceRef="Activity_close_the_case" targetRef="Event_case_closed" />
  </bpmn:process>
