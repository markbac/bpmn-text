<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Article publishing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:process id="Process_article_publishing" name="Article publishing" isExecutable="false">
    <bpmn:startEvent id="Event_draft_ready" name="Draft ready">
      <bpmn:outgoing>Flow_draft_ready__write</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="write" name="Write article">
      <bpmn:incoming>Flow_draft_ready__write</bpmn:incoming>
      <bpmn:incoming>Flow_apply_feedback__write</bpmn:incoming>
      <bpmn:outgoing>Flow_write__review_article</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="Activity_review_article" name="Review article">
      <bpmn:incoming>Flow_write__review_article</bpmn:incoming>
      <bpmn:outgoing>Flow_review_article__approved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_approved" name="Approved?">
      <bpmn:incoming>Flow_review_article__approved</bpmn:incoming>
      <bpmn:outgoing>Flow_approved__apply_feedback</bpmn:outgoing>
      <bpmn:outgoing>Flow_approved__article_dropped</bpmn:outgoing>
      <bpmn:outgoing>Flow_approved__and_1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_apply_feedback" name="Apply feedback">
      <bpmn:incoming>Flow_approved__apply_feedback</bpmn:incoming>
      <bpmn:outgoing>Flow_apply_feedback__write</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_article_dropped" name="Article dropped">
      <bpmn:incoming>Flow_approved__article_dropped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Gateway_and_1">
      <bpmn:incoming>Flow_approved__and_1</bpmn:incoming>
      <bpmn:outgoing>Flow_and_1__create_images</bpmn:outgoing>
      <bpmn:outgoing>Flow_and_1__write_social_posts</bpmn:outgoing>
      <bpmn:outgoing>Flow_and_1__translate_article</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Activity_create_images" name="Create images">
      <bpmn:incoming>Flow_and_1__create_images</bpmn:incoming>
      <bpmn:outgoing>Flow_create_images__join_after_extra_channels</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_write_social_posts" name="Write social posts">
      <bpmn:incoming>Flow_and_1__write_social_posts</bpmn:incoming>
      <bpmn:outgoing>Flow_write_social_posts__join_after_extra_channels</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_translate_article" name="Translate article">
      <bpmn:incoming>Flow_and_1__translate_article</bpmn:incoming>
      <bpmn:outgoing>Flow_translate_article__join_after_extra_channels</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Gateway_extra_channels" name="Extra channels?" default="Flow_extra_channels__join_after_publish">
      <bpmn:incoming>Flow_join_after_extra_channels__extra_channels</bpmn:incoming>
      <bpmn:outgoing>Flow_extra_channels__add_to_newsletter</bpmn:outgoing>
      <bpmn:outgoing>Flow_extra_channels__record_audio_version</bpmn:outgoing>
      <bpmn:outgoing>Flow_extra_channels__join_after_publish</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:parallelGateway id="Gateway_join_after_extra_channels">
      <bpmn:incoming>Flow_create_images__join_after_extra_channels</bpmn:incoming>
      <bpmn:incoming>Flow_write_social_posts__join_after_extra_channels</bpmn:incoming>
      <bpmn:incoming>Flow_translate_article__join_after_extra_channels</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_extra_channels__extra_channels</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_add_to_newsletter" name="Add to newsletter">
      <bpmn:incoming>Flow_extra_channels__add_to_newsletter</bpmn:incoming>
      <bpmn:outgoing>Flow_add_to_newsletter__join_after_publish</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Activity_record_audio_version" name="Record audio version">
      <bpmn:incoming>Flow_extra_channels__record_audio_version</bpmn:incoming>
      <bpmn:outgoing>Flow_record_audio_version__join_after_publish</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_publish" name="Publish">
      <bpmn:incoming>Flow_join_after_publish__publish</bpmn:incoming>
      <bpmn:outgoing>Flow_publish__published</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="Gateway_join_after_publish">
      <bpmn:incoming>Flow_add_to_newsletter__join_after_publish</bpmn:incoming>
      <bpmn:incoming>Flow_record_audio_version__join_after_publish</bpmn:incoming>
      <bpmn:incoming>Flow_extra_channels__join_after_publish</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_publish__publish</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:endEvent id="Event_published" name="Published">
      <bpmn:incoming>Flow_publish__published</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_draft_ready__write" sourceRef="Event_draft_ready" targetRef="write" />
    <bpmn:sequenceFlow id="Flow_write__review_article" sourceRef="write" targetRef="Activity_review_article" />
    <bpmn:sequenceFlow id="Flow_review_article__approved" sourceRef="Activity_review_article" targetRef="Gateway_approved" />
    <bpmn:sequenceFlow id="Flow_approved__apply_feedback" name="needs changes" sourceRef="Gateway_approved" targetRef="Activity_apply_feedback" />
    <bpmn:sequenceFlow id="Flow_approved__article_dropped" name="rejected" sourceRef="Gateway_approved" targetRef="Event_article_dropped" />
    <bpmn:sequenceFlow id="Flow_approved__and_1" name="yes" sourceRef="Gateway_approved" targetRef="Gateway_and_1" />
    <bpmn:sequenceFlow id="Flow_and_1__create_images" sourceRef="Gateway_and_1" targetRef="Activity_create_images" />
    <bpmn:sequenceFlow id="Flow_and_1__write_social_posts" sourceRef="Gateway_and_1" targetRef="Activity_write_social_posts" />
    <bpmn:sequenceFlow id="Flow_and_1__translate_article" sourceRef="Gateway_and_1" targetRef="Activity_translate_article" />
    <bpmn:sequenceFlow id="Flow_create_images__join_after_extra_channels" sourceRef="Activity_create_images" targetRef="Gateway_join_after_extra_channels" />
    <bpmn:sequenceFlow id="Flow_write_social_posts__join_after_extra_channels" sourceRef="Activity_write_social_posts" targetRef="Gateway_join_after_extra_channels" />
    <bpmn:sequenceFlow id="Flow_translate_article__join_after_extra_channels" sourceRef="Activity_translate_article" targetRef="Gateway_join_after_extra_channels" />
    <bpmn:sequenceFlow id="Flow_join_after_extra_channels__extra_channels" sourceRef="Gateway_join_after_extra_channels" targetRef="Gateway_extra_channels" />
    <bpmn:sequenceFlow id="Flow_extra_channels__add_to_newsletter" name="newsletter" sourceRef="Gateway_extra_channels" targetRef="Activity_add_to_newsletter" />
    <bpmn:sequenceFlow id="Flow_extra_channels__record_audio_version" name="podcast" sourceRef="Gateway_extra_channels" targetRef="Activity_record_audio_version" />
    <bpmn:sequenceFlow id="Flow_add_to_newsletter__join_after_publish" sourceRef="Activity_add_to_newsletter" targetRef="Gateway_join_after_publish" />
    <bpmn:sequenceFlow id="Flow_record_audio_version__join_after_publish" sourceRef="Activity_record_audio_version" targetRef="Gateway_join_after_publish" />
    <bpmn:sequenceFlow id="Flow_extra_channels__join_after_publish" sourceRef="Gateway_extra_channels" targetRef="Gateway_join_after_publish" />
    <bpmn:sequenceFlow id="Flow_join_after_publish__publish" sourceRef="Gateway_join_after_publish" targetRef="Activity_publish" />
    <bpmn:sequenceFlow id="Flow_publish__published" sourceRef="Activity_publish" targetRef="Event_published" />
    <bpmn:sequenceFlow id="Flow_apply_feedback__write" sourceRef="Activity_apply_feedback" targetRef="write" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_article_publishing">
