<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Order fulfilment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_customer" name="Customer" processRef="Process_customer" />
    <bpmn:participant id="Participant_company" name="Company" processRef="Process_company" />
    <bpmn:participant id="Participant_bank" name="Bank" />
    <bpmn:messageFlow id="MessageFlow_place_order__receive_order" sourceRef="Activity_place_order" targetRef="Activity_receive_order" />
    <bpmn:messageFlow id="MessageFlow_request_prepayment__bank" name="invoice" sourceRef="Activity_request_prepayment" targetRef="Participant_bank" />
    <bpmn:messageFlow id="MessageFlow_send_confirmation__confirmation" sourceRef="Activity_send_confirmation" targetRef="Activity_confirmation" />
    <bpmn:messageFlow id="MessageFlow_bank__payment_received" name="payment" sourceRef="Participant_bank" targetRef="Activity_payment_received" />
  </bpmn:collaboration>
  <bpmn:process id="Process_customer" isExecutable="false">
    <bpmn:startEvent id="Event_need_product" name="Need product">
      <bpmn:outgoing>Flow_need_product__place_order</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_place_order" name="Place order">
      <bpmn:incoming>Flow_need_product__place_order</bpmn:incoming>
      <bpmn:outgoing>Flow_place_order__confirmation</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_confirmation" name="Confirmation">
      <bpmn:incoming>Flow_place_order__confirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_confirmation__done</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_done" name="Done">
      <bpmn:incoming>Flow_confirmation__done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_need_product__place_order" sourceRef="Event_need_product" targetRef="Activity_place_order" />
    <bpmn:sequenceFlow id="Flow_place_order__confirmation" sourceRef="Activity_place_order" targetRef="Activity_confirmation" />
    <bpmn:sequenceFlow id="Flow_confirmation__done" sourceRef="Activity_confirmation" targetRef="Event_done" />
  </bpmn:process>
  <bpmn:process id="Process_company" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_company">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>Activity_receive_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_check_credit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_credit_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_request_prepayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_payment_received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Activity_pick_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_pack_parcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ship_parcel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_send_confirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_shipped</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_finance" name="Finance">
        <bpmn:flowNodeRef>Activity_issue_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_issue_invoice</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:receiveTask id="Activity_receive_order" name="Receive order">
      <bpmn:outgoing>Flow_receive_order__check_credit</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Activity_check_credit" name="Check credit">
      <bpmn:incoming>Flow_receive_order__check_credit</bpmn:incoming>
      <bpmn:outgoing>Flow_check_credit__credit_ok</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_credit_ok" name="Credit OK?">
      <bpmn:incoming>Flow_check_credit__credit_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_credit_ok__pick_items</bpmn:outgoing>
      <bpmn:outgoing>Flow_credit_ok__request_prepayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_pick_items" name="Pick items">
      <bpmn:incoming>Flow_credit_ok__pick_items</bpmn:incoming>
      <bpmn:outgoing>Flow_pick_items__pack_parcel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_pack_parcel" name="Pack parcel">
      <bpmn:incoming>Flow_pick_items__pack_parcel</bpmn:incoming>
      <bpmn:outgoing>Flow_pack_parcel__join_after_issue_invoice</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Activity_request_prepayment" name="Request prepayment">
      <bpmn:incoming>Flow_credit_ok__request_prepayment</bpmn:incoming>
      <bpmn:outgoing>Flow_request_prepayment__payment_received</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_payment_received" name="Payment received">
      <bpmn:incoming>Flow_request_prepayment__payment_received</bpmn:incoming>
      <bpmn:outgoing>Flow_payment_received__join_after_issue_invoice</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:task id="Activity_issue_invoice" name="Issue invoice">
      <bpmn:incoming>Flow_join_after_issue_invoice__issue_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_issue_invoice__ship_parcel</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_join_after_issue_invoice">
      <bpmn:incoming>Flow_pack_parcel__join_after_issue_invoice</bpmn:incoming>
      <bpmn:incoming>Flow_payment_received__join_after_issue_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_issue_invoice__issue_invoice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_ship_parcel" name="Ship parcel">
      <bpmn:incoming>Flow_issue_invoice__ship_parcel</bpmn:incoming>
      <bpmn:outgoing>Flow_ship_parcel__send_confirmation</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="Activity_send_confirmation" name="Send confirmation">
      <bpmn:incoming>Flow_ship_parcel__send_confirmation</bpmn:incoming>
      <bpmn:outgoing>Flow_send_confirmation__shipped</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_shipped" name="Shipped">
      <bpmn:incoming>Flow_send_confirmation__shipped</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_receive_order__check_credit" sourceRef="Activity_receive_order" targetRef="Activity_check_credit" />
    <bpmn:sequenceFlow id="Flow_check_credit__credit_ok" sourceRef="Activity_check_credit" targetRef="Gateway_credit_ok" />
    <bpmn:sequenceFlow id="Flow_credit_ok__pick_items" name="yes" sourceRef="Gateway_credit_ok" targetRef="Activity_pick_items" />
    <bpmn:sequenceFlow id="Flow_pick_items__pack_parcel" sourceRef="Activity_pick_items" targetRef="Activity_pack_parcel" />
    <bpmn:sequenceFlow id="Flow_credit_ok__request_prepayment" name="no" sourceRef="Gateway_credit_ok" targetRef="Activity_request_prepayment" />
    <bpmn:sequenceFlow id="Flow_request_prepayment__payment_received" sourceRef="Activity_request_prepayment" targetRef="Activity_payment_received" />
    <bpmn:sequenceFlow id="Flow_pack_parcel__join_after_issue_invoice" sourceRef="Activity_pack_parcel" targetRef="Gateway_join_after_issue_invoice" />
    <bpmn:sequenceFlow id="Flow_payment_received__join_after_issue_invoice" sourceRef="Activity_payment_received" targetRef="Gateway_join_after_issue_invoice" />
    <bpmn:sequenceFlow id="Flow_join_after_issue_invoice__issue_invoice" sourceRef="Gateway_join_after_issue_invoice" targetRef="Activity_issue_invoice" />
    <bpmn:sequenceFlow id="Flow_issue_invoice__ship_parcel" sourceRef="Activity_issue_invoice" targetRef="Activity_ship_parcel" />
    <bpmn:sequenceFlow id="Flow_ship_parcel__send_confirmation" sourceRef="Activity_ship_parcel" targetRef="Activity_send_confirmation" />
    <bpmn:sequenceFlow id="Flow_send_confirmation__shipped" sourceRef="Activity_send_confirmation" targetRef="Event_shipped" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
