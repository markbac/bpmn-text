<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Solar panel installation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:category id="Category_groups">
    <bpmn:categoryValue id="CategoryValue_fulfilment" value="Fulfilment" />
    <bpmn:categoryValue id="CategoryValue_after_sales" value="After-sales" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>From signed order to a working installation and the first service visit.</bpmn:documentation>
    <bpmn:participant id="Participant_installer" name="Installer" processRef="Process_installer">
      <bpmn:documentation>A regional installer of rooftop solar panels.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:group id="Group_fulfilment" categoryValueRef="CategoryValue_fulfilment" />
    <bpmn:group id="Group_after_sales" categoryValueRef="CategoryValue_after_sales" />
  </bpmn:collaboration>
  <bpmn:process id="Process_installer" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_installer">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>Event_order_signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_confirm_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ask_for_deposit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_deposit_received</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_credit_control" name="Credit control">
        <bpmn:flowNodeRef>Activity_credit_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_credit_approved</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_planning" name="Planning">
        <bpmn:flowNodeRef>Activity_plan_installation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_publish_plan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_publish_plan</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_warehouse" name="Warehouse">
        <bpmn:flowNodeRef>Activity_pick_panels_and_inverter</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_logistics" name="Logistics">
        <bpmn:flowNodeRef>Activity_book_delivery_van</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_deliver_kit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_deliver_kit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_field_service" name="Field service">
        <bpmn:flowNodeRef>Activity_install_panels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_hand_over_installation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_service_visit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_fault_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_repair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_investigate_complaint</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_billing" name="Billing">
        <bpmn:flowNodeRef>Activity_send_final_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_installation_complete</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_customer_care" name="Customer care">
        <bpmn:flowNodeRef>Event_six_months_after_installation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_call_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_file_visit_report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_visit_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_visit_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_complaint_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_log_complaint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_complaint_closed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_order_signed" name="Order signed">
      <bpmn:documentation>The customer has signed the quote in the portal.</bpmn:documentation>
      <bpmn:outgoing>Flow_order_signed__confirm_order</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_order_signed_definition" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_confirm_order" name="Confirm order">
      <bpmn:documentation>Check the quote against the site survey and confirm the order.</bpmn:documentation>
      <bpmn:incoming>Flow_order_signed__confirm_order</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_order__credit_check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Activity_credit_check" name="Credit check">
      <bpmn:documentation>Runs the standard credit check, documented in the credit manual.</bpmn:documentation>
      <bpmn:incoming>Flow_confirm_order__credit_check</bpmn:incoming>
      <bpmn:outgoing>Flow_credit_check__credit_approved</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_credit_approved" name="Credit approved?">
      <bpmn:documentation>The credit check decides whether the order goes ahead.</bpmn:documentation>
      <bpmn:incoming>Flow_credit_check__credit_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_credit_approved__plan_installation</bpmn:outgoing>
      <bpmn:outgoing>Flow_credit_approved__ask_for_deposit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_plan_installation" name="Plan installation">
      <bpmn:documentation>Pick an installation date and a crew.</bpmn:documentation>
      <bpmn:incoming>Flow_credit_approved__plan_installation</bpmn:incoming>
      <bpmn:outgoing>Flow_plan_installation__join_after_publish_plan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_ask_for_deposit" name="Ask for deposit">
      <bpmn:documentation>Ask the customer for a 30% deposit instead.</bpmn:documentation>
      <bpmn:incoming>Flow_credit_approved__ask_for_deposit</bpmn:incoming>
      <bpmn:outgoing>Flow_ask_for_deposit__deposit_received</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_deposit_received" name="Deposit received">
      <bpmn:documentation>The deposit has arrived in the bank account.</bpmn:documentation>
      <bpmn:incoming>Flow_ask_for_deposit__deposit_received</bpmn:incoming>
      <bpmn:outgoing>Flow_deposit_received__join_after_publish_plan</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_deposit_received_definition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_publish_plan" name="Publish plan">
      <bpmn:documentation>Publishes the plan to the warehouse and logistics systems.</bpmn:documentation>
      <bpmn:incoming>Flow_join_after_publish_plan__publish_plan</bpmn:incoming>
      <bpmn:outgoing>Flow_publish_plan__pick_panels_and_inverter</bpmn:outgoing>
      <bpmn:outgoing>Flow_publish_plan__book_delivery_van</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_join_after_publish_plan">
      <bpmn:incoming>Flow_plan_installation__join_after_publish_plan</bpmn:incoming>
      <bpmn:incoming>Flow_deposit_received__join_after_publish_plan</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_publish_plan__publish_plan</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_pick_panels_and_inverter" name="Pick panels and inverter">
      <bpmn:documentation>Pick the kit from stock and stage it at the loading bay.</bpmn:documentation>
      <bpmn:incoming>Flow_publish_plan__pick_panels_and_inverter</bpmn:incoming>
      <bpmn:outgoing>Flow_pick_panels_and_inverter__join_after_deliver_kit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_book_delivery_van" name="Book delivery van">
      <bpmn:documentation>Book a van for the day before installation.</bpmn:documentation>
      <bpmn:incoming>Flow_publish_plan__book_delivery_van</bpmn:incoming>
      <bpmn:outgoing>Flow_book_delivery_van__join_after_deliver_kit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:task id="Activity_deliver_kit" name="Deliver kit">
      <bpmn:documentation>Deliver the kit to the customer's site.</bpmn:documentation>
      <bpmn:incoming>Flow_join_after_deliver_kit__deliver_kit</bpmn:incoming>
      <bpmn:outgoing>Flow_deliver_kit__install_panels</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_join_after_deliver_kit">
      <bpmn:incoming>Flow_pick_panels_and_inverter__join_after_deliver_kit</bpmn:incoming>
      <bpmn:incoming>Flow_book_delivery_van__join_after_deliver_kit</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_deliver_kit__deliver_kit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:subProcess id="Activity_install_panels" name="Install panels">
      <bpmn:documentation>Mount, wire and commission the panels, as in the installation manual.</bpmn:documentation>
      <bpmn:incoming>Flow_deliver_kit__install_panels</bpmn:incoming>
      <bpmn:outgoing>Flow_install_panels__hand_over_installation</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:userTask id="Activity_hand_over_installation" name="Hand over installation">
      <bpmn:documentation>Show the customer the app and the isolation switch.</bpmn:documentation>
      <bpmn:incoming>Flow_install_panels__hand_over_installation</bpmn:incoming>
      <bpmn:outgoing>Flow_hand_over_installation__send_final_invoice</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_send_final_invoice" name="Send final invoice">
      <bpmn:documentation>Invoice the remaining amount.</bpmn:documentation>
      <bpmn:incoming>Flow_hand_over_installation__send_final_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_send_final_invoice__installation_complete</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_installation_complete" name="Installation complete">
      <bpmn:documentation>The installation is live and invoiced.</bpmn:documentation>
      <bpmn:incoming>Flow_send_final_invoice__installation_complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_six_months_after_installation" name="Six months after installation">
      <bpmn:documentation>Every installation gets a service visit after six months.</bpmn:documentation>
      <bpmn:outgoing>Flow_six_months_after_installation__call_customer</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_six_months_after_installation_definition" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_call_customer" name="Call customer">
      <bpmn:documentation>Agree a date for the service visit.</bpmn:documentation>
      <bpmn:incoming>Flow_six_months_after_installation__call_customer</bpmn:incoming>
      <bpmn:outgoing>Flow_call_customer__service_visit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_service_visit" name="Service visit">
      <bpmn:documentation>Clean the panels and check the inverter logs.</bpmn:documentation>
      <bpmn:incoming>Flow_call_customer__service_visit</bpmn:incoming>
      <bpmn:outgoing>Flow_service_visit__fault_found</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_fault_found" name="Fault found?">
      <bpmn:documentation>A fault is anything the inverter logs report.</bpmn:documentation>
      <bpmn:incoming>Flow_service_visit__fault_found</bpmn:incoming>
      <bpmn:outgoing>Flow_fault_found__repair</bpmn:outgoing>
      <bpmn:outgoing>Flow_fault_found__file_visit_report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Activity_repair" name="Repair">
      <bpmn:documentation>Repairs follow the warranty process.</bpmn:documentation>
      <bpmn:incoming>Flow_fault_found__repair</bpmn:incoming>
      <bpmn:outgoing>Flow_repair__join_after_visit_closed</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:manualTask id="Activity_file_visit_report" name="File visit report">
      <bpmn:documentation>File the signed report in the customer folder.</bpmn:documentation>
      <bpmn:incoming>Flow_fault_found__file_visit_report</bpmn:incoming>
      <bpmn:outgoing>Flow_file_visit_report__join_after_visit_closed</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Event_visit_closed" name="Visit closed">
      <bpmn:documentation>The customer has a working installation.</bpmn:documentation>
      <bpmn:incoming>Flow_join_after_visit_closed__visit_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_join_after_visit_closed">
      <bpmn:incoming>Flow_repair__join_after_visit_closed</bpmn:incoming>
      <bpmn:incoming>Flow_file_visit_report__join_after_visit_closed</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_visit_closed__visit_closed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="Event_complaint_received" name="Complaint received">
      <bpmn:documentation>A customer complains by phone or e-mail.</bpmn:documentation>
      <bpmn:outgoing>Flow_complaint_received__log_complaint</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_complaint_received_definition" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_log_complaint" name="Log complaint">
      <bpmn:documentation>Record the complaint and promise a call back within a day.</bpmn:documentation>
      <bpmn:incoming>Flow_complaint_received__log_complaint</bpmn:incoming>
      <bpmn:outgoing>Flow_log_complaint__investigate_complaint</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_investigate_complaint" name="Investigate complaint">
      <bpmn:documentation>Visit the site if needed.</bpmn:documentation>
      <bpmn:incoming>Flow_log_complaint__investigate_complaint</bpmn:incoming>
      <bpmn:outgoing>Flow_investigate_complaint__complaint_closed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_complaint_closed" name="Complaint closed">
      <bpmn:documentation>The customer has accepted the answer.</bpmn:documentation>
      <bpmn:incoming>Flow_investigate_complaint__complaint_closed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_order_signed__confirm_order" sourceRef="Event_order_signed" targetRef="Activity_confirm_order" />
    <bpmn:sequenceFlow id="Flow_confirm_order__credit_check" sourceRef="Activity_confirm_order" targetRef="Activity_credit_check" />
    <bpmn:sequenceFlow id="Flow_credit_check__credit_approved" sourceRef="Activity_credit_check" targetRef="Gateway_credit_approved" />
    <bpmn:sequenceFlow id="Flow_credit_approved__plan_installation" name="yes" sourceRef="Gateway_credit_approved" targetRef="Activity_plan_installation" />
    <bpmn:sequenceFlow id="Flow_credit_approved__ask_for_deposit" name="no" sourceRef="Gateway_credit_approved" targetRef="Activity_ask_for_deposit" />
    <bpmn:sequenceFlow id="Flow_ask_for_deposit__deposit_received" sourceRef="Activity_ask_for_deposit" targetRef="Event_deposit_received" />
    <bpmn:sequenceFlow id="Flow_plan_installation__join_after_publish_plan" sourceRef="Activity_plan_installation" targetRef="Gateway_join_after_publish_plan" />
    <bpmn:sequenceFlow id="Flow_deposit_received__join_after_publish_plan" sourceRef="Event_deposit_received" targetRef="Gateway_join_after_publish_plan" />
    <bpmn:sequenceFlow id="Flow_join_after_publish_plan__publish_plan" sourceRef="Gateway_join_after_publish_plan" targetRef="Activity_publish_plan" />
    <bpmn:sequenceFlow id="Flow_publish_plan__pick_panels_and_inverter" sourceRef="Activity_publish_plan" targetRef="Activity_pick_panels_and_inverter" />
    <bpmn:sequenceFlow id="Flow_publish_plan__book_delivery_van" sourceRef="Activity_publish_plan" targetRef="Activity_book_delivery_van" />
    <bpmn:sequenceFlow id="Flow_pick_panels_and_inverter__join_after_deliver_kit" sourceRef="Activity_pick_panels_and_inverter" targetRef="Gateway_join_after_deliver_kit" />
    <bpmn:sequenceFlow id="Flow_book_delivery_van__join_after_deliver_kit" sourceRef="Activity_book_delivery_van" targetRef="Gateway_join_after_deliver_kit" />
    <bpmn:sequenceFlow id="Flow_join_after_deliver_kit__deliver_kit" sourceRef="Gateway_join_after_deliver_kit" targetRef="Activity_deliver_kit" />
    <bpmn:sequenceFlow id="Flow_deliver_kit__install_panels" sourceRef="Activity_deliver_kit" targetRef="Activity_install_panels" />
    <bpmn:sequenceFlow id="Flow_install_panels__hand_over_installation" sourceRef="Activity_install_panels" targetRef="Activity_hand_over_installation" />
    <bpmn:sequenceFlow id="Flow_hand_over_installation__send_final_invoice" sourceRef="Activity_hand_over_installation" targetRef="Activity_send_final_invoice" />
    <bpmn:sequenceFlow id="Flow_send_final_invoice__installation_complete" sourceRef="Activity_send_final_invoice" targetRef="Event_installation_complete" />
    <bpmn:sequenceFlow id="Flow_six_months_after_installation__call_customer" sourceRef="Event_six_months_after_installation" targetRef="Activity_call_customer" />
    <bpmn:sequenceFlow id="Flow_call_customer__service_visit" sourceRef="Activity_call_customer" targetRef="Activity_service_visit" />
    <bpmn:sequenceFlow id="Flow_service_visit__fault_found" sourceRef="Activity_service_visit" targetRef="Gateway_fault_found" />
    <bpmn:sequenceFlow id="Flow_fault_found__repair" name="yes" sourceRef="Gateway_fault_found" targetRef="Activity_repair" />
    <bpmn:sequenceFlow id="Flow_fault_found__file_visit_report" name="no" sourceRef="Gateway_fault_found" targetRef="Activity_file_visit_report" />
    <bpmn:sequenceFlow id="Flow_repair__join_after_visit_closed" sourceRef="Activity_repair" targetRef="Gateway_join_after_visit_closed" />
    <bpmn:sequenceFlow id="Flow_file_visit_report__join_after_visit_closed" sourceRef="Activity_file_visit_report" targetRef="Gateway_join_after_visit_closed" />
    <bpmn:sequenceFlow id="Flow_join_after_visit_closed__visit_closed" sourceRef="Gateway_join_after_visit_closed" targetRef="Event_visit_closed" />
    <bpmn:sequenceFlow id="Flow_complaint_received__log_complaint" sourceRef="Event_complaint_received" targetRef="Activity_log_complaint" />
    <bpmn:sequenceFlow id="Flow_log_complaint__investigate_complaint" sourceRef="Activity_log_complaint" targetRef="Activity_investigate_complaint" />
    <bpmn:sequenceFlow id="Flow_investigate_complaint__complaint_closed" sourceRef="Activity_investigate_complaint" targetRef="Event_complaint_closed" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_installer_di" bpmnElement="Participant_installer" isHorizontal="true">
        <dc:Bounds x="0" y="0" width="3050" height="1500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_sales_di" bpmnElement="Lane_sales" isHorizontal="true" bioc:fill="#E3F2FD" color:background-color="#E3F2FD">
        <dc:Bounds x="30" y="0" width="3020" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_credit_control_di" bpmnElement="Lane_credit_control" isHorizontal="true" bioc:fill="#E3F2FD" color:background-color="#E3F2FD">
        <dc:Bounds x="30" y="160" width="3020" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_planning_di" bpmnElement="Lane_planning" isHorizontal="true" bioc:fill="#FFF8E1" color:background-color="#FFF8E1">
        <dc:Bounds x="30" y="320" width="3020" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_warehouse_di" bpmnElement="Lane_warehouse" isHorizontal="true" bioc:fill="#FFF8E1" color:background-color="#FFF8E1">
        <dc:Bounds x="30" y="480" width="3020" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_logistics_di" bpmnElement="Lane_logistics" isHorizontal="true" bioc:fill="#FFF8E1" color:background-color="#FFF8E1">
        <dc:Bounds x="30" y="640" width="3020" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_field_service_di" bpmnElement="Lane_field_service" isHorizontal="true" bioc:fill="#E8F5E9" color:background-color="#E8F5E9">
        <dc:Bounds x="30" y="800" width="3020" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_billing_di" bpmnElement="Lane_billing" isHorizontal="true" bioc:fill="#F3E5F5" color:background-color="#F3E5F5">
        <dc:Bounds x="30" y="1070" width="3020" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_customer_care_di" bpmnElement="Lane_customer_care" isHorizontal="true" bioc:fill="#F3E5F5" color:background-color="#F3E5F5">
        <dc:Bounds x="30" y="1230" width="3020" height="270" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_order_signed_di" bpmnElement="Event_order_signed">
        <dc:Bounds x="128" y="62" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="114" y="103" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_confirm_order_di" bpmnElement="Activity_confirm_order">
        <dc:Bounds x="214" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_credit_check_di" bpmnElement="Activity_credit_check" isExpanded="false">
        <dc:Bounds x="376" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_credit_approved_di" bpmnElement="Gateway_credit_approved">
        <dc:Bounds x="526" y="215" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="581" y="196" width="85" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_plan_installation_di" bpmnElement="Activity_plan_installation">
        <dc:Bounds x="776" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ask_for_deposit_di" bpmnElement="Activity_ask_for_deposit">
        <dc:Bounds x="626" y="40" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_deposit_received_di" bpmnElement="Event_deposit_received">
