<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Invoice approval" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_company" name="Company" processRef="Process_company" />
  </bpmn:collaboration>
  <bpmn:process id="Process_company" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_company">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>Event_order_shipped</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_draft_invoice</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_finance" name="Finance">
        <bpmn:flowNodeRef>Activity_approve_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_send_invoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_invoice_sent</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_order_shipped" name="Order shipped">
      <bpmn:outgoing>Flow_order_shipped__draft_invoice</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_draft_invoice" name="Draft invoice">
      <bpmn:incoming>Flow_order_shipped__draft_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_draft_invoice__approve_invoice</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_draft_invoice__invoice_draft">
        <bpmn:targetRef>DataObjectReference_invoice_draft</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:userTask id="Activity_approve_invoice" name="Approve invoice">
      <bpmn:incoming>Flow_draft_invoice__approve_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_invoice__send_invoice</bpmn:outgoing>
      <bpmn:property id="Activity_approve_invoice_property" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_approve_invoice__invoice_draft">
        <bpmn:sourceRef>DataObjectReference_invoice_draft</bpmn:sourceRef>
        <bpmn:targetRef>Activity_approve_invoice_property</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_approve_invoice__invoice_approved">
        <bpmn:targetRef>DataObjectReference_invoice_approved</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_send_invoice" name="Send invoice">
      <bpmn:incoming>Flow_approve_invoice__send_invoice</bpmn:incoming>
      <bpmn:outgoing>Flow_send_invoice__invoice_sent</bpmn:outgoing>
      <bpmn:property id="Activity_send_invoice_property" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_send_invoice__invoice_approved">
        <bpmn:sourceRef>DataObjectReference_invoice_approved</bpmn:sourceRef>
        <bpmn:targetRef>Activity_send_invoice_property</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_send_invoice__invoice_sent">
        <bpmn:targetRef>DataObjectReference_invoice_sent</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_invoice_sent" name="Invoice sent">
      <bpmn:incoming>Flow_send_invoice__invoice_sent</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_order_shipped__draft_invoice" sourceRef="Event_order_shipped" targetRef="Activity_draft_invoice" />
    <bpmn:sequenceFlow id="Flow_draft_invoice__approve_invoice" sourceRef="Activity_draft_invoice" targetRef="Activity_approve_invoice" />
    <bpmn:sequenceFlow id="Flow_approve_invoice__send_invoice" sourceRef="Activity_approve_invoice" targetRef="Activity_send_invoice" />
    <bpmn:sequenceFlow id="Flow_send_invoice__invoice_sent" sourceRef="Activity_send_invoice" targetRef="Event_invoice_sent" />
    <bpmn:dataObject id="DataObject_invoice" isCollection="true" />
    <bpmn:dataObjectReference id="DataObjectReference_invoice_draft" name="Invoice&#10;[draft]" dataObjectRef="DataObject_invoice">
      <bpmn:dataState id="DataObjectReference_invoice_draft_state" name="draft" />
    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="DataObjectReference_invoice_approved" name="Invoice&#10;[approved]" dataObjectRef="DataObject_invoice">
      <bpmn:dataState id="DataObjectReference_invoice_approved_state" name="approved" />
    </bpmn:dataObjectReference>
    <bpmn:dataObjectReference id="DataObjectReference_invoice_sent" name="Invoice&#10;[sent]" dataObjectRef="DataObject_invoice">
      <bpmn:dataState id="DataObjectReference_invoice_sent_state" name="sent" />
    </bpmn:dataObjectReference>
  </bpmn:process>
