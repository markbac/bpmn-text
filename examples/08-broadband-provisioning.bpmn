        <bpmn:outgoing>Flow_tests_pass__activation_failed</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Event_service_active" name="Service active">
        <bpmn:incoming>Flow_tests_pass__service_active</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="Event_activation_failed" name="Activation failed">
