      <bpmn:outgoing>Flow_validate_openreach_order__openreach_order_valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_openreach_order_valid" name="Openreach order valid?">
