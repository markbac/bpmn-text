<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Full-fibre broadband provisioning" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:category id="Category_groups">
    <bpmn:categoryValue id="CategoryValue_quote_and_order" value="Quote and order" />
    <bpmn:categoryValue id="CategoryValue_build" value="Build" />
    <bpmn:categoryValue id="CategoryValue_go_live" value="Go live" />
    <bpmn:categoryValue id="CategoryValue_aftercare" value="Aftercare" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>From a customer's quote request to a working, billed full-fibre line on Openreach or CityFibre, and the first check-in afterwards.</bpmn:documentation>
    <bpmn:participant id="Participant_customer" name="Customer" processRef="Process_customer">
      <bpmn:documentation>A household getting full-fibre broadband, new or switching from another provider.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_courier" name="Courier" />
    <bpmn:participant id="Participant_cityfibre" name="CityFibre" processRef="Process_cityfibre">
      <bpmn:documentation>An alternative wholesale full-fibre network in many towns and cities.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_brightwave_broadband" name="Brightwave Broadband" processRef="Process_brightwave_broadband">
      <bpmn:documentation>The retail provider: sells the service, builds it in its own systems and bills for it.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_openreach" name="Openreach" processRef="Process_openreach">
      <bpmn:documentation>The national wholesale network that builds and connects the fibre.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_credit_agency" name="Credit agency" />
    <bpmn:participant id="Participant_one_touch_switch_hub" name="One Touch Switch hub" />
    <bpmn:messageFlow id="MessageFlow_request_a_quote__quote_requested" sourceRef="Activity_request_a_quote" targetRef="Event_quote_requested" />
    <bpmn:messageFlow id="MessageFlow_place_order__customer_order_received" sourceRef="Activity_place_order" targetRef="Activity_customer_order_received" />
    <bpmn:messageFlow id="MessageFlow_courier__router_arrives" sourceRef="Participant_courier" targetRef="Activity_router_arrives" />
    <bpmn:messageFlow id="MessageFlow_courier__delivery_confirmed" sourceRef="Participant_courier" targetRef="Activity_delivery_confirmed" />
    <bpmn:messageFlow id="MessageFlow_return_cityfibre_availability__cityfibre_availability" sourceRef="Activity_return_cityfibre_availability" targetRef="Activity_cityfibre_availability" />
    <bpmn:messageFlow id="MessageFlow_reject_cityfibre_order__order_rejected" sourceRef="Activity_reject_cityfibre_order" targetRef="Activity_order_rejected" />
    <bpmn:messageFlow id="MessageFlow_commit_cityfibre_date__committed_date_received" sourceRef="Activity_commit_cityfibre_date" targetRef="Activity_committed_date_received" />
    <bpmn:messageFlow id="MessageFlow_send_cityfibre_completion__completion_notice" sourceRef="Activity_send_cityfibre_completion" targetRef="Activity_completion_notice" />
    <bpmn:messageFlow id="MessageFlow_ask_openreach_for_availability__openreach_availability_request" sourceRef="Activity_ask_openreach_for_availability" targetRef="Event_openreach_availability_request" />
    <bpmn:messageFlow id="MessageFlow_ask_cityfibre_for_availability__cityfibre_availability_request" sourceRef="Activity_ask_cityfibre_for_availability" targetRef="Event_cityfibre_availability_request" />
    <bpmn:messageFlow id="MessageFlow_send_offer__offer_received" sourceRef="Activity_send_offer" targetRef="Activity_offer_received" />
    <bpmn:messageFlow id="MessageFlow_request_switch_match__one_touch_switch_hub" name="name, address, current provider" sourceRef="Activity_request_switch_match" targetRef="Participant_one_touch_switch_hub" />
    <bpmn:messageFlow id="MessageFlow_tell_customer_no_service__no_service_at_the_address" sourceRef="Activity_tell_customer_no_service" targetRef="Activity_no_service_at_the_address" />
    <bpmn:messageFlow id="MessageFlow_run_credit_check__credit_agency" name="applicant details" sourceRef="Activity_run_credit_check" targetRef="Participant_credit_agency" />
    <bpmn:messageFlow id="MessageFlow_decline_order__order_declined" sourceRef="Activity_decline_order" targetRef="Activity_order_declined" />
    <bpmn:messageFlow id="MessageFlow_confirm_order__order_confirmed" sourceRef="Activity_confirm_order" targetRef="Activity_order_confirmed" />
    <bpmn:messageFlow id="MessageFlow_order_from_openreach__openreach_order_received" sourceRef="Activity_order_from_openreach" targetRef="Event_openreach_order_received" />
    <bpmn:messageFlow id="MessageFlow_order_from_cityfibre__cityfibre_order_received" sourceRef="Activity_order_from_cityfibre" targetRef="Event_cityfibre_order_received" />
    <bpmn:messageFlow id="MessageFlow_tell_customer_the_date__installation_date" sourceRef="Activity_tell_customer_the_date" targetRef="Activity_installation_date" />
    <bpmn:messageFlow id="MessageFlow_port_phone_number__one_touch_switch_hub" sourceRef="Activity_port_phone_number" targetRef="Participant_one_touch_switch_hub" />
    <bpmn:messageFlow id="MessageFlow_dispatch_router__courier" name="shipping order" sourceRef="Activity_dispatch_router" targetRef="Participant_courier" />
    <bpmn:messageFlow id="MessageFlow_confirm_installation__installation_done" sourceRef="Activity_confirm_installation" targetRef="Activity_installation_done" />
    <bpmn:messageFlow id="MessageFlow_send_welcome_pack__welcome_pack" sourceRef="Activity_send_welcome_pack" targetRef="Activity_welcome_pack" />
    <bpmn:messageFlow id="MessageFlow_return_openreach_availability__openreach_availability" sourceRef="Activity_return_openreach_availability" targetRef="Activity_openreach_availability" />
    <bpmn:messageFlow id="MessageFlow_reject_openreach_order__order_rejected" sourceRef="Activity_reject_openreach_order" targetRef="Activity_order_rejected" />
    <bpmn:messageFlow id="MessageFlow_commit_openreach_date__committed_date_received" sourceRef="Activity_commit_openreach_date" targetRef="Activity_committed_date_received" />
    <bpmn:messageFlow id="MessageFlow_notify_delay__brightwave_broadband" sourceRef="Activity_notify_delay" targetRef="Participant_brightwave_broadband" />
    <bpmn:messageFlow id="MessageFlow_commit_switch_date__committed_date_received" sourceRef="Activity_commit_switch_date" targetRef="Activity_committed_date_received" />
    <bpmn:messageFlow id="MessageFlow_send_openreach_completion__completion_notice" sourceRef="Activity_send_openreach_completion" targetRef="Activity_completion_notice" />
    <bpmn:messageFlow id="MessageFlow_credit_agency__credit_result" sourceRef="Participant_credit_agency" targetRef="Activity_credit_result" />
    <bpmn:messageFlow id="MessageFlow_one_touch_switch_hub__switch_match_received" sourceRef="Participant_one_touch_switch_hub" targetRef="Activity_switch_match_received" />
    <bpmn:group id="Group_quote_and_order" categoryValueRef="CategoryValue_quote_and_order" />
    <bpmn:group id="Group_build" categoryValueRef="CategoryValue_build" />
    <bpmn:group id="Group_go_live" categoryValueRef="CategoryValue_go_live" />
    <bpmn:group id="Group_aftercare" categoryValueRef="CategoryValue_aftercare" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_address_database" name="Address database" />
  <bpmn:dataStore id="DataStore_product_catalogue" name="Product catalogue" />
  <bpmn:dataStore id="DataStore_oss_inventory" name="OSS inventory" />
  <bpmn:dataStore id="DataStore_billing_system" name="Billing system" />
  <bpmn:process id="Process_customer" isExecutable="false">
    <bpmn:startEvent id="Event_wants_faster_broadband" name="Wants faster broadband">
      <bpmn:outgoing>Flow_wants_faster_broadband__request_a_quote</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Activity_request_a_quote" name="Request a quote">
      <bpmn:incoming>Flow_wants_faster_broadband__request_a_quote</bpmn:incoming>
      <bpmn:outgoing>Flow_request_a_quote__wait_for_the_quote</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_wait_for_the_quote" name="Wait for the quote">
      <bpmn:incoming>Flow_request_a_quote__wait_for_the_quote</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_for_the_quote__offer_received</bpmn:outgoing>
      <bpmn:outgoing>Flow_wait_for_the_quote__no_service_at_the_address</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Activity_offer_received" name="Offer received">
      <bpmn:incoming>Flow_wait_for_the_quote__offer_received</bpmn:incoming>
      <bpmn:outgoing>Flow_offer_received__choose_speed_and_extras</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Activity_choose_speed_and_extras" name="Choose speed and extras">
      <bpmn:documentation>For example 500 Mbps with digital voice, keeping the current phone number.</bpmn:documentation>
      <bpmn:incoming>Flow_offer_received__choose_speed_and_extras</bpmn:incoming>
      <bpmn:outgoing>Flow_choose_speed_and_extras__place_order</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_place_order" name="Place order">
      <bpmn:incoming>Flow_choose_speed_and_extras__place_order</bpmn:incoming>
      <bpmn:outgoing>Flow_place_order__wait_for_the_provider</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_wait_for_the_provider" name="Wait for the provider">
      <bpmn:incoming>Flow_place_order__wait_for_the_provider</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_for_the_provider__order_confirmed</bpmn:outgoing>
      <bpmn:outgoing>Flow_wait_for_the_provider__order_declined</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="Activity_order_confirmed" name="Order confirmed">
      <bpmn:incoming>Flow_wait_for_the_provider__order_confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_order_confirmed__installation_date</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Activity_order_declined" name="Order declined">
      <bpmn:incoming>Flow_wait_for_the_provider__order_declined</bpmn:incoming>
      <bpmn:outgoing>Flow_order_declined__order_not_accepted</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_order_not_accepted" name="Order not accepted">
      <bpmn:incoming>Flow_order_declined__order_not_accepted</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Activity_no_service_at_the_address" name="No service at the address">
      <bpmn:incoming>Flow_wait_for_the_quote__no_service_at_the_address</bpmn:incoming>
      <bpmn:outgoing>Flow_no_service_at_the_address__not_available</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_not_available" name="Not available">
      <bpmn:incoming>Flow_no_service_at_the_address__not_available</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:receiveTask id="Activity_installation_date" name="Installation date">
      <bpmn:incoming>Flow_order_confirmed__installation_date</bpmn:incoming>
      <bpmn:outgoing>Flow_installation_date__router_arrives</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Activity_router_arrives" name="Router arrives">
      <bpmn:incoming>Flow_installation_date__router_arrives</bpmn:incoming>
      <bpmn:outgoing>Flow_router_arrives__installation_done</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Activity_installation_done" name="Installation done">
      <bpmn:incoming>Flow_router_arrives__installation_done</bpmn:incoming>
      <bpmn:outgoing>Flow_installation_done__welcome_pack</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Activity_welcome_pack" name="Welcome pack">
      <bpmn:incoming>Flow_installation_done__welcome_pack</bpmn:incoming>
      <bpmn:outgoing>Flow_welcome_pack__online</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="Event_online" name="Online">
      <bpmn:incoming>Flow_welcome_pack__online</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_wants_faster_broadband__request_a_quote" sourceRef="Event_wants_faster_broadband" targetRef="Activity_request_a_quote" />
    <bpmn:sequenceFlow id="Flow_request_a_quote__wait_for_the_quote" sourceRef="Activity_request_a_quote" targetRef="Gateway_wait_for_the_quote" />
    <bpmn:sequenceFlow id="Flow_wait_for_the_quote__offer_received" sourceRef="Gateway_wait_for_the_quote" targetRef="Activity_offer_received" />
    <bpmn:sequenceFlow id="Flow_offer_received__choose_speed_and_extras" sourceRef="Activity_offer_received" targetRef="Activity_choose_speed_and_extras" />
    <bpmn:sequenceFlow id="Flow_choose_speed_and_extras__place_order" sourceRef="Activity_choose_speed_and_extras" targetRef="Activity_place_order" />
    <bpmn:sequenceFlow id="Flow_place_order__wait_for_the_provider" sourceRef="Activity_place_order" targetRef="Gateway_wait_for_the_provider" />
    <bpmn:sequenceFlow id="Flow_wait_for_the_provider__order_confirmed" sourceRef="Gateway_wait_for_the_provider" targetRef="Activity_order_confirmed" />
    <bpmn:sequenceFlow id="Flow_wait_for_the_provider__order_declined" sourceRef="Gateway_wait_for_the_provider" targetRef="Activity_order_declined" />
    <bpmn:sequenceFlow id="Flow_order_declined__order_not_accepted" sourceRef="Activity_order_declined" targetRef="Event_order_not_accepted" />
    <bpmn:sequenceFlow id="Flow_wait_for_the_quote__no_service_at_the_address" sourceRef="Gateway_wait_for_the_quote" targetRef="Activity_no_service_at_the_address" />
    <bpmn:sequenceFlow id="Flow_no_service_at_the_address__not_available" sourceRef="Activity_no_service_at_the_address" targetRef="Event_not_available" />
    <bpmn:sequenceFlow id="Flow_order_confirmed__installation_date" sourceRef="Activity_order_confirmed" targetRef="Activity_installation_date" />
    <bpmn:sequenceFlow id="Flow_installation_date__router_arrives" sourceRef="Activity_installation_date" targetRef="Activity_router_arrives" />
    <bpmn:sequenceFlow id="Flow_router_arrives__installation_done" sourceRef="Activity_router_arrives" targetRef="Activity_installation_done" />
    <bpmn:sequenceFlow id="Flow_installation_done__welcome_pack" sourceRef="Activity_installation_done" targetRef="Activity_welcome_pack" />
    <bpmn:sequenceFlow id="Flow_welcome_pack__online" sourceRef="Activity_welcome_pack" targetRef="Event_online" />
  </bpmn:process>
  <bpmn:process id="Process_cityfibre" isExecutable="false">
    <bpmn:startEvent id="Event_cityfibre_availability_request" name="CityFibre availability request">
      <bpmn:outgoing>Flow_cityfibre_availability_request__check_cityfibre_coverage</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_cityfibre_availability_request_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_check_cityfibre_coverage" name="Check CityFibre coverage">
      <bpmn:incoming>Flow_cityfibre_availability_request__check_cityfibre_coverage</bpmn:incoming>
      <bpmn:outgoing>Flow_check_cityfibre_coverage__return_cityfibre_availability</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_return_cityfibre_availability" name="Return CityFibre availability">
      <bpmn:incoming>Flow_check_cityfibre_coverage__return_cityfibre_availability</bpmn:incoming>
      <bpmn:outgoing>Flow_return_cityfibre_availability__cityfibre_answered</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_cityfibre_answered" name="CityFibre answered">
      <bpmn:incoming>Flow_return_cityfibre_availability__cityfibre_answered</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Event_cityfibre_order_received" name="CityFibre order received">
      <bpmn:outgoing>Flow_cityfibre_order_received__validate_cityfibre_order</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_cityfibre_order_received_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_validate_cityfibre_order" name="Validate CityFibre order">
      <bpmn:incoming>Flow_cityfibre_order_received__validate_cityfibre_order</bpmn:incoming>
      <bpmn:outgoing>Flow_validate_cityfibre_order__cityfibre_order_valid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_cityfibre_order_valid" name="CityFibre order valid?">
      <bpmn:incoming>Flow_validate_cityfibre_order__cityfibre_order_valid</bpmn:incoming>
      <bpmn:outgoing>Flow_cityfibre_order_valid__reject_cityfibre_order</bpmn:outgoing>
      <bpmn:outgoing>Flow_cityfibre_order_valid__book_installer</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_reject_cityfibre_order" name="Reject CityFibre order">
      <bpmn:incoming>Flow_cityfibre_order_valid__reject_cityfibre_order</bpmn:incoming>
      <bpmn:outgoing>Flow_reject_cityfibre_order__cityfibre_rejected</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_cityfibre_rejected" name="CityFibre rejected">
      <bpmn:incoming>Flow_reject_cityfibre_order__cityfibre_rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_book_installer" name="Book installer">
      <bpmn:incoming>Flow_cityfibre_order_valid__book_installer</bpmn:incoming>
      <bpmn:outgoing>Flow_book_installer__commit_cityfibre_date</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_commit_cityfibre_date" name="Commit CityFibre date">
      <bpmn:incoming>Flow_book_installer__commit_cityfibre_date</bpmn:incoming>
      <bpmn:outgoing>Flow_commit_cityfibre_date__install_cityfibre_connection</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Activity_install_cityfibre_connection" name="Install CityFibre connection">
      <bpmn:incoming>Flow_commit_cityfibre_date__install_cityfibre_connection</bpmn:incoming>
      <bpmn:outgoing>Flow_install_cityfibre_connection__send_cityfibre_completion</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_send_cityfibre_completion" name="Send CityFibre completion">
      <bpmn:incoming>Flow_install_cityfibre_connection__send_cityfibre_completion</bpmn:incoming>
      <bpmn:outgoing>Flow_send_cityfibre_completion__cityfibre_order_complete</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_cityfibre_order_complete" name="CityFibre order complete">
      <bpmn:incoming>Flow_send_cityfibre_completion__cityfibre_order_complete</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_cityfibre_availability_request__check_cityfibre_coverage" sourceRef="Event_cityfibre_availability_request" targetRef="Activity_check_cityfibre_coverage" />
    <bpmn:sequenceFlow id="Flow_check_cityfibre_coverage__return_cityfibre_availability" sourceRef="Activity_check_cityfibre_coverage" targetRef="Activity_return_cityfibre_availability" />
    <bpmn:sequenceFlow id="Flow_return_cityfibre_availability__cityfibre_answered" sourceRef="Activity_return_cityfibre_availability" targetRef="Event_cityfibre_answered" />
    <bpmn:sequenceFlow id="Flow_cityfibre_order_received__validate_cityfibre_order" sourceRef="Event_cityfibre_order_received" targetRef="Activity_validate_cityfibre_order" />
    <bpmn:sequenceFlow id="Flow_validate_cityfibre_order__cityfibre_order_valid" sourceRef="Activity_validate_cityfibre_order" targetRef="Gateway_cityfibre_order_valid" />
    <bpmn:sequenceFlow id="Flow_cityfibre_order_valid__reject_cityfibre_order" name="no" sourceRef="Gateway_cityfibre_order_valid" targetRef="Activity_reject_cityfibre_order" />
    <bpmn:sequenceFlow id="Flow_reject_cityfibre_order__cityfibre_rejected" sourceRef="Activity_reject_cityfibre_order" targetRef="Event_cityfibre_rejected" />
    <bpmn:sequenceFlow id="Flow_cityfibre_order_valid__book_installer" name="yes" sourceRef="Gateway_cityfibre_order_valid" targetRef="Activity_book_installer" />
    <bpmn:sequenceFlow id="Flow_book_installer__commit_cityfibre_date" sourceRef="Activity_book_installer" targetRef="Activity_commit_cityfibre_date" />
    <bpmn:sequenceFlow id="Flow_commit_cityfibre_date__install_cityfibre_connection" sourceRef="Activity_commit_cityfibre_date" targetRef="Activity_install_cityfibre_connection" />
    <bpmn:sequenceFlow id="Flow_install_cityfibre_connection__send_cityfibre_completion" sourceRef="Activity_install_cityfibre_connection" targetRef="Activity_send_cityfibre_completion" />
    <bpmn:sequenceFlow id="Flow_send_cityfibre_completion__cityfibre_order_complete" sourceRef="Activity_send_cityfibre_completion" targetRef="Event_cityfibre_order_complete" />
  </bpmn:process>
  <bpmn:process id="Process_brightwave_broadband" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_brightwave_broadband">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>Event_quote_requested</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_find_address_key</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_check_both_networks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ask_openreach_for_availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_openreach_availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ask_cityfibre_for_availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_cityfibre_availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_any_full_fibre_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_any_full_fibre_available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_build_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_send_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_customer_order_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_new_line_or_transfer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_request_switch_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_switch_match_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_tell_customer_no_service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_no_service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_confirm_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_credit_and_fraud" name="Credit and fraud">
        <bpmn:flowNodeRef>Activity_run_credit_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_credit_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_credit_decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_review_application_manually</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_approved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_decline_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_declined</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_order_management" name="Order management">
        <bpmn:flowNodeRef>Activity_place_wholesale_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_which_network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_order_from_openreach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_order_from_cityfibre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_wait_for_the_network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_wait_for_the_network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_committed_date_received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_order_rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_correct_order_details</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_2_working_days</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_chase_the_network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_tell_customer_the_date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_completion_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_completion_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_join_after_completion_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_after_join_after_join_after_completion_notice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_confirm_installation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_network_provisioning" name="Network provisioning">
        <bpmn:flowNodeRef>Activity_reserve_ip_and_service_id</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_configure_radius_and_speed_profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_activate_service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_activation_failed_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_voice" name="Voice">
        <bpmn:flowNodeRef>Gateway_digital_voice_ordered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_set_up_digital_voice_line</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_keep_current_number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_port_phone_number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_allocate_new_number</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_logistics" name="Logistics">
        <bpmn:flowNodeRef>Activity_dispatch_router</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_delivery_confirmed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_billing" name="Billing">
        <bpmn:flowNodeRef>Activity_create_billing_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_start_billing</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_customer_care" name="Customer care">
        <bpmn:flowNodeRef>Activity_troubleshoot_with_the_customer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_send_welcome_pack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_customer_live</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_14_days_after_go_live</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_satisfaction_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_customer_happy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_case_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_raise_service_ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ticket_raised</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_quote_requested" name="Quote requested">
      <bpmn:documentation>Quote requests arrive from the website with the address and, for a transfer, the current provider.</bpmn:documentation>
      <bpmn:outgoing>Flow_quote_requested__find_address_key</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_quote_requested_definition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_find_address_key" name="Find address key">
      <bpmn:documentation>Looks up the UPRN and each network's address key for it.</bpmn:documentation>
      <bpmn:incoming>Flow_quote_requested__find_address_key</bpmn:incoming>
      <bpmn:outgoing>Flow_find_address_key__check_both_networks</bpmn:outgoing>
      <bpmn:property id="Activity_find_address_key_property" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_find_address_key__address_database">
        <bpmn:sourceRef>DataStoreReference_address_database</bpmn:sourceRef>
        <bpmn:targetRef>Activity_find_address_key_property</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_check_both_networks" name="Check both networks">
      <bpmn:incoming>Flow_find_address_key__check_both_networks</bpmn:incoming>
      <bpmn:outgoing>Flow_check_both_networks__ask_openreach_for_availability</bpmn:outgoing>
      <bpmn:outgoing>Flow_check_both_networks__ask_cityfibre_for_availability</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="Activity_ask_openreach_for_availability" name="Ask Openreach for availability">
      <bpmn:incoming>Flow_check_both_networks__ask_openreach_for_availability</bpmn:incoming>
      <bpmn:outgoing>Flow_ask_openreach_for_availability__openreach_availability</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_openreach_availability" name="Openreach availability">
      <bpmn:incoming>Flow_ask_openreach_for_availability__openreach_availability</bpmn:incoming>
      <bpmn:outgoing>Flow_openreach_availability__join_after_any_full_fibre_available</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_ask_cityfibre_for_availability" name="Ask CityFibre for availability">
      <bpmn:incoming>Flow_check_both_networks__ask_cityfibre_for_availability</bpmn:incoming>
      <bpmn:outgoing>Flow_ask_cityfibre_for_availability__cityfibre_availability</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_cityfibre_availability" name="CityFibre availability">
      <bpmn:incoming>Flow_ask_cityfibre_for_availability__cityfibre_availability</bpmn:incoming>
      <bpmn:outgoing>Flow_cityfibre_availability__join_after_any_full_fibre_available</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_any_full_fibre_available" name="Any full fibre available?">
      <bpmn:incoming>Flow_join_after_any_full_fibre_available__any_full_fibre_available</bpmn:incoming>
      <bpmn:outgoing>Flow_any_full_fibre_available__build_offer</bpmn:outgoing>
      <bpmn:outgoing>Flow_any_full_fibre_available__tell_customer_no_service</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_join_after_any_full_fibre_available">
      <bpmn:incoming>Flow_openreach_availability__join_after_any_full_fibre_available</bpmn:incoming>
      <bpmn:incoming>Flow_cityfibre_availability__join_after_any_full_fibre_available</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_any_full_fibre_available__any_full_fibre_available</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Activity_build_offer" name="Build offer">
      <bpmn:documentation>Speed tiers per available network (for example 150, 500 and 900 Mbps, and 2 Gbps on CityFibre), with extras: digital voice, number porting, a mesh Wi-Fi booster.</bpmn:documentation>
      <bpmn:incoming>Flow_any_full_fibre_available__build_offer</bpmn:incoming>
      <bpmn:outgoing>Flow_build_offer__send_offer</bpmn:outgoing>
      <bpmn:property id="Activity_build_offer_property" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_build_offer__product_catalogue">
        <bpmn:sourceRef>DataStoreReference_product_catalogue</bpmn:sourceRef>
        <bpmn:targetRef>Activity_build_offer_property</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Activity_send_offer" name="Send offer">
      <bpmn:incoming>Flow_build_offer__send_offer</bpmn:incoming>
      <bpmn:outgoing>Flow_send_offer__customer_order_received</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="Activity_customer_order_received" name="Customer order received">
      <bpmn:incoming>Flow_send_offer__customer_order_received</bpmn:incoming>
      <bpmn:outgoing>Flow_customer_order_received__new_line_or_transfer</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_new_line_or_transfer" name="New line or transfer?">
      <bpmn:incoming>Flow_customer_order_received__new_line_or_transfer</bpmn:incoming>
      <bpmn:outgoing>Flow_new_line_or_transfer__request_switch_match</bpmn:outgoing>
      <bpmn:outgoing>Flow_new_line_or_transfer__run_credit_check</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_request_switch_match" name="Request switch match">
      <bpmn:incoming>Flow_new_line_or_transfer__request_switch_match</bpmn:incoming>
      <bpmn:outgoing>Flow_request_switch_match__switch_match_received</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_switch_match_received" name="Switch match received">
      <bpmn:documentation>The hub returns a switch order reference and tells the current provider; their service ends on the switch date.</bpmn:documentation>
      <bpmn:incoming>Flow_request_switch_match__switch_match_received</bpmn:incoming>
      <bpmn:outgoing>Flow_switch_match_received__run_credit_check</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:sendTask id="Activity_tell_customer_no_service" name="Tell customer no service">
      <bpmn:incoming>Flow_any_full_fibre_available__tell_customer_no_service</bpmn:incoming>
      <bpmn:outgoing>Flow_tell_customer_no_service__no_service</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_no_service" name="No service">
      <bpmn:incoming>Flow_tell_customer_no_service__no_service</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_run_credit_check" name="Run credit check">
      <bpmn:incoming>Flow_new_line_or_transfer__run_credit_check</bpmn:incoming>
      <bpmn:incoming>Flow_switch_match_received__run_credit_check</bpmn:incoming>
      <bpmn:outgoing>Flow_run_credit_check__credit_result</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_credit_result" name="Credit result">
      <bpmn:incoming>Flow_run_credit_check__credit_result</bpmn:incoming>
      <bpmn:outgoing>Flow_credit_result__credit_decision</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="Gateway_credit_decision" name="Credit decision?">
      <bpmn:incoming>Flow_credit_result__credit_decision</bpmn:incoming>
      <bpmn:outgoing>Flow_credit_decision__review_application_manually</bpmn:outgoing>
      <bpmn:outgoing>Flow_credit_decision__join_after_approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_review_application_manually" name="Review application manually">
      <bpmn:documentation>Fraud analysts check identity documents within one working day and record approve or decline.</bpmn:documentation>
      <bpmn:incoming>Flow_credit_decision__review_application_manually</bpmn:incoming>
      <bpmn:outgoing>Flow_review_application_manually__join_after_approved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_approved" name="Approved?">
      <bpmn:incoming>Flow_join_after_approved__approved</bpmn:incoming>
      <bpmn:outgoing>Flow_approved__decline_order</bpmn:outgoing>
      <bpmn:outgoing>Flow_approved__confirm_order</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_join_after_approved">
      <bpmn:incoming>Flow_review_application_manually__join_after_approved</bpmn:incoming>
      <bpmn:incoming>Flow_credit_decision__join_after_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_approved__approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_decline_order" name="Decline order">
      <bpmn:incoming>Flow_approved__decline_order</bpmn:incoming>
      <bpmn:outgoing>Flow_decline_order__declined</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="Event_declined" name="Declined">
      <bpmn:incoming>Flow_decline_order__declined</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Activity_confirm_order" name="Confirm order">
      <bpmn:incoming>Flow_approved__confirm_order</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_order__place_wholesale_order</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Activity_place_wholesale_order" name="Place wholesale order">
      <bpmn:documentation>A new-provide or a transfer order, with the address key, the speed tier and the appointment preference.</bpmn:documentation>
      <bpmn:incoming>Flow_confirm_order__place_wholesale_order</bpmn:incoming>
      <bpmn:incoming>Flow_correct_order_details__place_wholesale_order</bpmn:incoming>
      <bpmn:outgoing>Flow_place_wholesale_order__which_network</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_place_wholesale_order__wholesale_order">
        <bpmn:targetRef>DataObjectReference_wholesale_order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_which_network" name="Which network?">
      <bpmn:incoming>Flow_place_wholesale_order__which_network</bpmn:incoming>
      <bpmn:outgoing>Flow_which_network__order_from_openreach</bpmn:outgoing>
      <bpmn:outgoing>Flow_which_network__order_from_cityfibre</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="Activity_order_from_openreach" name="Order from Openreach">
      <bpmn:incoming>Flow_which_network__order_from_openreach</bpmn:incoming>
      <bpmn:outgoing>Flow_order_from_openreach__join_after_wait_for_the_network</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Activity_order_from_cityfibre" name="Order from CityFibre">
      <bpmn:incoming>Flow_which_network__order_from_cityfibre</bpmn:incoming>
      <bpmn:outgoing>Flow_order_from_cityfibre__join_after_wait_for_the_network</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="Gateway_wait_for_the_network" name="Wait for the network">
      <bpmn:incoming>Flow_join_after_wait_for_the_network__wait_for_the_network</bpmn:incoming>
      <bpmn:incoming>Flow_chase_the_network__wait_for_the_network</bpmn:incoming>
      <bpmn:outgoing>Flow_wait_for_the_network__committed_date_received</bpmn:outgoing>
      <bpmn:outgoing>Flow_wait_for_the_network__order_rejected</bpmn:outgoing>
      <bpmn:outgoing>Flow_wait_for_the_network__2_working_days</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:exclusiveGateway id="Gateway_join_after_wait_for_the_network">
      <bpmn:incoming>Flow_order_from_openreach__join_after_wait_for_the_network</bpmn:incoming>
      <bpmn:incoming>Flow_order_from_cityfibre__join_after_wait_for_the_network</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_wait_for_the_network__wait_for_the_network</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="Activity_committed_date_received" name="Committed date received">
      <bpmn:incoming>Flow_wait_for_the_network__committed_date_received</bpmn:incoming>
      <bpmn:outgoing>Flow_committed_date_received__tell_customer_the_date</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="Activity_order_rejected" name="Order rejected">
      <bpmn:incoming>Flow_wait_for_the_network__order_rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_order_rejected__correct_order_details</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="Activity_correct_order_details" name="Correct order details">
      <bpmn:documentation>Typical rejections: wrong address key, a tier the line cannot carry, missing access details.</bpmn:documentation>
      <bpmn:incoming>Flow_order_rejected__correct_order_details</bpmn:incoming>
      <bpmn:outgoing>Flow_correct_order_details__place_wholesale_order</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_2_working_days" name="2 working days">
      <bpmn:incoming>Flow_wait_for_the_network__2_working_days</bpmn:incoming>
      <bpmn:outgoing>Flow_2_working_days__chase_the_network</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_2_working_days_definition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_chase_the_network" name="Chase the network">
      <bpmn:incoming>Flow_2_working_days__chase_the_network</bpmn:incoming>
      <bpmn:outgoing>Flow_chase_the_network__wait_for_the_network</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Activity_tell_customer_the_date" name="Tell customer the date">
      <bpmn:incoming>Flow_committed_date_received__tell_customer_the_date</bpmn:incoming>
      <bpmn:outgoing>Flow_tell_customer_the_date__reserve_ip_and_service_id</bpmn:outgoing>
      <bpmn:outgoing>Flow_tell_customer_the_date__digital_voice_ordered</bpmn:outgoing>
      <bpmn:outgoing>Flow_tell_customer_the_date__dispatch_router</bpmn:outgoing>
      <bpmn:outgoing>Flow_tell_customer_the_date__create_billing_account</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Activity_reserve_ip_and_service_id" name="Reserve IP and service ID">
      <bpmn:incoming>Flow_tell_customer_the_date__reserve_ip_and_service_id</bpmn:incoming>
      <bpmn:outgoing>Flow_reserve_ip_and_service_id__configure_radius_and_speed_profile</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_reserve_ip_and_service_id__oss_inventory">
        <bpmn:targetRef>DataStoreReference_oss_inventory</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_configure_radius_and_speed_profile" name="Configure RADIUS and speed profile">
      <bpmn:incoming>Flow_reserve_ip_and_service_id__configure_radius_and_speed_profile</bpmn:incoming>
      <bpmn:outgoing>Flow_configure_radius_and_speed_profile__join_after_completion_notice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_digital_voice_ordered" name="Digital voice ordered?">
      <bpmn:incoming>Flow_tell_customer_the_date__digital_voice_ordered</bpmn:incoming>
      <bpmn:outgoing>Flow_digital_voice_ordered__set_up_digital_voice_line</bpmn:outgoing>
      <bpmn:outgoing>Flow_digital_voice_ordered__join_after_join_after_completion_notice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_set_up_digital_voice_line" name="Set up digital voice line">
      <bpmn:incoming>Flow_digital_voice_ordered__set_up_digital_voice_line</bpmn:incoming>
      <bpmn:outgoing>Flow_set_up_digital_voice_line__keep_current_number</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_keep_current_number" name="Keep current number?">
      <bpmn:incoming>Flow_set_up_digital_voice_line__keep_current_number</bpmn:incoming>
      <bpmn:outgoing>Flow_keep_current_number__port_phone_number</bpmn:outgoing>
      <bpmn:outgoing>Flow_keep_current_number__allocate_new_number</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_port_phone_number" name="Port phone number">
      <bpmn:incoming>Flow_keep_current_number__port_phone_number</bpmn:incoming>
      <bpmn:outgoing>Flow_port_phone_number__join_after_join_after_join_after_completion_notice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_allocate_new_number" name="Allocate new number">
      <bpmn:incoming>Flow_keep_current_number__allocate_new_number</bpmn:incoming>
      <bpmn:outgoing>Flow_allocate_new_number__join_after_join_after_join_after_completion_notice</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_dispatch_router" name="Dispatch router">
      <bpmn:incoming>Flow_tell_customer_the_date__dispatch_router</bpmn:incoming>
      <bpmn:outgoing>Flow_dispatch_router__delivery_confirmed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_delivery_confirmed" name="Delivery confirmed">
      <bpmn:incoming>Flow_dispatch_router__delivery_confirmed</bpmn:incoming>
      <bpmn:outgoing>Flow_delivery_confirmed__join_after_completion_notice</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:serviceTask id="Activity_create_billing_account" name="Create billing account">
      <bpmn:documentation>The account is created now but stays inactive until the line is live.</bpmn:documentation>
      <bpmn:incoming>Flow_tell_customer_the_date__create_billing_account</bpmn:incoming>
      <bpmn:outgoing>Flow_create_billing_account__join_after_completion_notice</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_create_billing_account__billing_system">
        <bpmn:targetRef>DataStoreReference_billing_system</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:receiveTask id="Activity_completion_notice" name="Completion notice">
      <bpmn:incoming>Flow_join_after_completion_notice__completion_notice</bpmn:incoming>
      <bpmn:outgoing>Flow_completion_notice__confirm_installation</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:parallelGateway id="Gateway_join_after_completion_notice">
      <bpmn:incoming>Flow_configure_radius_and_speed_profile__join_after_completion_notice</bpmn:incoming>
      <bpmn:incoming>Flow_join_after_join_after_completion_notice__join_after_completion_notice</bpmn:incoming>
      <bpmn:incoming>Flow_delivery_confirmed__join_after_completion_notice</bpmn:incoming>
      <bpmn:incoming>Flow_create_billing_account__join_after_completion_notice</bpmn:incoming>
      <bpmn:outgoing>Flow_join_after_completion_notice__completion_notice</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_join_after_join_after_completion_notice">
