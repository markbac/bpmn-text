    </bpmn:sendTask>
    <bpmn:endEvent id="Event_delay_notified" name="Delay notified">
      <bpmn:incoming>Flow_notify_delay__delay_notified</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_schedule_remote_switch_over" name="Schedule remote switch-over">
      <bpmn:documentation>The existing fibre and ONT stay; the line moves to the new provider on the switch date.</bpmn:documentation>
      <bpmn:incoming>Flow_order_type__schedule_remote_switch_over</bpmn:incoming>
      <bpmn:outgoing>Flow_schedule_remote_switch_over__commit_switch_date</bpmn:outgoing>
