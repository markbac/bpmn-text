# Subprocesses, data objects/stores, annotations and activity markers.
# covers: §4.2, §4.4, §4.5, §8, §10
title "Invoice run"

store Accounting DB

start timer Last working day of month
service Collect billable hours [reads: Accounting DB, writes: Hours report]
note Includes contractors from the timesheet export
sub Create invoices [parallel]
  start
  task Calculate totals [reads: Hours report]
  service Generate PDF [writes: Invoice]
  end
  on error Missing rate -> user Fix rate card -> end Invoice skipped
sub Send invoices [collapsed]
  start
  service Email invoice
  wait 30 days
  service Check payment [loop]
  end
end Run complete
