<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" name="Order handling" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-text">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_shop" name="Shop" processRef="Process_shop" />
  </bpmn:collaboration>
  <bpmn:message id="Message_order_placed" name="Order placed" />
  <bpmn:error id="Error_out_of_stock" name="Out of stock" />
  <bpmn:signal id="Signal_count_started" name="Count started" />
  <bpmn:message id="Message_order_paid" name="Order paid" />
  <bpmn:message id="Message_order_cancelled" name="Order cancelled" />
  <bpmn:process id="Process_shop" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_shop">
      <bpmn:lane id="Lane_sales" name="Sales">
        <bpmn:flowNodeRef>Event_order_placed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_handle_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_cancellation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_billing" name="Billing">
        <bpmn:flowNodeRef>Activity_take_payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_order_paid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_daily_report</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_order_placed" name="Order placed">
      <bpmn:outgoing>Flow_order_placed__handle_order</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_order_placed_definition" messageRef="Message_order_placed" />
    </bpmn:startEvent>
    <bpmn:subProcess id="Activity_handle_order" name="Handle order">
      <bpmn:incoming>Flow_order_placed__handle_order</bpmn:incoming>
      <bpmn:outgoing>Flow_handle_order__take_payment</bpmn:outgoing>
      <bpmn:startEvent id="Event_handle_order_start_1">
        <bpmn:outgoing>Flow_handle_order_start_1__pick_items</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Activity_pick_items" name="Pick items">
        <bpmn:incoming>Flow_handle_order_start_1__pick_items</bpmn:incoming>
        <bpmn:outgoing>Flow_pick_items__ship_parcel</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Activity_ship_parcel" name="Ship parcel">
        <bpmn:incoming>Flow_pick_items__ship_parcel</bpmn:incoming>
        <bpmn:outgoing>Flow_ship_parcel__handle_order_end_1</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="Event_handle_order_end_1">
        <bpmn:incoming>Flow_ship_parcel__handle_order_end_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess id="Activity_item_missing" name="Item missing" triggeredByEvent="true">
        <bpmn:startEvent id="Event_out_of_stock" name="Out of stock">
          <bpmn:outgoing>Flow_out_of_stock__offer_a_substitute</bpmn:outgoing>
          <bpmn:errorEventDefinition id="Event_out_of_stock_definition" errorRef="Error_out_of_stock" />
        </bpmn:startEvent>
        <bpmn:task id="Activity_offer_a_substitute" name="Offer a substitute">
          <bpmn:incoming>Flow_out_of_stock__offer_a_substitute</bpmn:incoming>
          <bpmn:outgoing>Flow_offer_a_substitute__item_missing_end_1</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="Event_item_missing_end_1">
          <bpmn:incoming>Flow_offer_a_substitute__item_missing_end_1</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_out_of_stock__offer_a_substitute" sourceRef="Event_out_of_stock" targetRef="Activity_offer_a_substitute" />
        <bpmn:sequenceFlow id="Flow_offer_a_substitute__item_missing_end_1" sourceRef="Activity_offer_a_substitute" targetRef="Event_item_missing_end_1" />
      </bpmn:subProcess>
      <bpmn:subProcess id="Activity_stock_count" name="Stock count" triggeredByEvent="true">
        <bpmn:startEvent id="Event_count_started" name="Count started" isInterrupting="false">
          <bpmn:outgoing>Flow_count_started__report_open_orders</bpmn:outgoing>
          <bpmn:signalEventDefinition id="Event_count_started_definition" signalRef="Signal_count_started" />
        </bpmn:startEvent>
        <bpmn:task id="Activity_report_open_orders" name="Report open orders">
          <bpmn:incoming>Flow_count_started__report_open_orders</bpmn:incoming>
          <bpmn:outgoing>Flow_report_open_orders__stock_count_end_1</bpmn:outgoing>
        </bpmn:task>
        <bpmn:endEvent id="Event_stock_count_end_1">
          <bpmn:incoming>Flow_report_open_orders__stock_count_end_1</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_count_started__report_open_orders" sourceRef="Event_count_started" targetRef="Activity_report_open_orders" />
        <bpmn:sequenceFlow id="Flow_report_open_orders__stock_count_end_1" sourceRef="Activity_report_open_orders" targetRef="Event_stock_count_end_1" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_handle_order_start_1__pick_items" sourceRef="Event_handle_order_start_1" targetRef="Activity_pick_items" />
      <bpmn:sequenceFlow id="Flow_pick_items__ship_parcel" sourceRef="Activity_pick_items" targetRef="Activity_ship_parcel" />
      <bpmn:sequenceFlow id="Flow_ship_parcel__handle_order_end_1" sourceRef="Activity_ship_parcel" targetRef="Event_handle_order_end_1" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Activity_take_payment" name="Take payment">
      <bpmn:incoming>Flow_handle_order__take_payment</bpmn:incoming>
      <bpmn:outgoing>Flow_take_payment__order_paid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_order_paid" name="Order paid">
      <bpmn:incoming>Flow_take_payment__order_paid</bpmn:incoming>
      <bpmn:messageEventDefinition id="Event_order_paid_definition" messageRef="Message_order_paid" />
    </bpmn:endEvent>
    <bpmn:subProcess id="Activity_cancellation" name="Cancellation" triggeredByEvent="true">
      <bpmn:startEvent id="Event_order_cancelled" name="Order cancelled">
        <bpmn:outgoing>Flow_order_cancelled__refund_customer</bpmn:outgoing>
        <bpmn:messageEventDefinition id="Event_order_cancelled_definition" messageRef="Message_order_cancelled" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_refund_customer" name="Refund customer">
        <bpmn:incoming>Flow_order_cancelled__refund_customer</bpmn:incoming>
        <bpmn:outgoing>Flow_refund_customer__refunded</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_refunded" name="Refunded">
        <bpmn:incoming>Flow_refund_customer__refunded</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_order_cancelled__refund_customer" sourceRef="Event_order_cancelled" targetRef="Activity_refund_customer" />
      <bpmn:sequenceFlow id="Flow_refund_customer__refunded" sourceRef="Activity_refund_customer" targetRef="Event_refunded" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Activity_daily_report" name="Daily report" triggeredByEvent="true">
      <bpmn:startEvent id="Event_every_morning" name="Every morning" isInterrupting="false">
        <bpmn:outgoing>Flow_every_morning__update_the_ledger</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Event_every_morning_definition" />
      </bpmn:startEvent>
      <bpmn:serviceTask id="Activity_update_the_ledger" name="Update the ledger">
        <bpmn:incoming>Flow_every_morning__update_the_ledger</bpmn:incoming>
        <bpmn:outgoing>Flow_update_the_ledger__daily_report_end_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_daily_report_end_1">
        <bpmn:incoming>Flow_update_the_ledger__daily_report_end_1</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_every_morning__update_the_ledger" sourceRef="Event_every_morning" targetRef="Activity_update_the_ledger" />
      <bpmn:sequenceFlow id="Flow_update_the_ledger__daily_report_end_1" sourceRef="Activity_update_the_ledger" targetRef="Event_daily_report_end_1" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_order_placed__handle_order" sourceRef="Event_order_placed" targetRef="Activity_handle_order" />
    <bpmn:sequenceFlow id="Flow_handle_order__take_payment" sourceRef="Activity_handle_order" targetRef="Activity_take_payment" />
    <bpmn:sequenceFlow id="Flow_take_payment__order_paid" sourceRef="Activity_take_payment" targetRef="Event_order_paid" />
  </bpmn:process>
