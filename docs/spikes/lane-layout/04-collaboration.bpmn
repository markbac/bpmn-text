        <di:waypoint x="998" y="450" />
        <di:waypoint x="1085" y="450" />
        <di:waypoint x="1085" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Activity_payment_received__Gateway_join_di" bpmnElement="Flow_Activity_payment_received__Gateway_join">
        <di:waypoint x="998" y="290" />
        <di:waypoint x="1085" y="290" />
        <di:waypoint x="1085" y="585" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Gateway_join__Activity_issue_invoice_di" bpmnElement="Flow_Gateway_join__Activity_issue_invoice">
        <di:waypoint x="1110" y="610" />
        <di:waypoint x="1160" y="610" />
      </bpmndi:BPMNEdge>
