      <bpmndi:BPMNShape id="Activity_add_to_newsletter_di" bpmnElement="Activity_add_to_newsletter"><dc:Bounds x="1110" y="40" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_record_audio_version_di" bpmnElement="Activity_record_audio_version"><dc:Bounds x="1110" y="150" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_or_join_di" bpmnElement="Gateway_or_join"><dc:Bounds x="1260" y="55" width="50" height="50" /></bpmndi:BPMNShape>
