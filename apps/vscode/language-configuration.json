{
  "comments": { "lineComment": "#" },
  "brackets": [["[", "]"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(pool|sub|group|xor|and|or|event|complex|on|doc\\s*$|.*:\\s*$)",
    "decreaseIndentPattern": "^$"
  }
}
